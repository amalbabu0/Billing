<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FurniShop.Wpf.ViewModels"
                    xmlns:c="clr-namespace:FurniShop.Wpf.Controls">

    <!-- =================================================================== Customer list -->
    <DataTemplate DataType="{x:Type vm:CustomerListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ New customer" Command="{Binding NewCommand}" VerticalAlignment="Top"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <c:AdaptiveList>
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.ServerSort="True" c:GridBehaviors.OpenCommand="{Binding OpenCommand}"
                                  AutomationProperties.Name="Customers">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Customer" SortMemberPath="name" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Code}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="120"/>
                                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/>
                                <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="150"/>
                                <DataGridTextColumn Header="Purchases" Binding="{Binding TotalPurchases, Converter={StaticResource Money}}" SortMemberPath="purchases" Width="130" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTemplateColumn Header="Outstanding" SortMemberPath="outstanding" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Outstanding, Converter={StaticResource Money}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{Binding Outstanding, Converter={StaticResource BalanceBrush}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last purchase" Binding="{Binding LastPurchaseDate, Converter={StaticResource Date}, ConverterParameter=dash}" SortMemberPath="recent" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}" BorderThickness="0" ItemContainerStyle="{StaticResource PlainListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Outstanding, Converter={StaticResource Money}}" Foreground="{Binding Outstanding, Converter={StaticResource BalanceBrush}}" FontWeight="SemiBold"/>
                                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Mobile, Mode=OneWay}"/> · <Run Text="{Binding City, Mode=OneWay}"/></TextBlock></StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </c:AdaptiveList>
                    <c:EmptyState Title="No customers" Message="{Binding EmptyMessage}" Icon="&#xE716;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Customer edit dialog -->
    <DataTemplate DataType="{x:Type vm:CustomerEditDialogViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Name *" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Name}" c:FocusBehavior.FocusOnLoad="True"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Name}" Style="{StaticResource FieldError}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mobile *" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Mobile}" MaxLength="15"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Mobile}" Style="{StaticResource FieldError}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WhatsApp (if different)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Whatsapp}" MaxLength="15"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Whatsapp}" Style="{StaticResource FieldError}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Email" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Email}"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Email}" Style="{StaticResource FieldError}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Billing address" Style="{StaticResource Label}" Margin="0,10,0,4"/>
            <TextBox Text="{Binding BillingAddress}" Style="{StaticResource MultilineBox}" MinHeight="54"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="City" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding City}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="State (decides CGST+SGST or IGST)" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" DisplayMemberPath="Display"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=StateCode}" Style="{StaticResource FieldError}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="PIN code" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Pincode}" MaxLength="6"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Pincode}" Style="{StaticResource FieldError}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GSTIN (business customers)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" CharacterCasing="Upper"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Gstin}" Style="{StaticResource FieldError}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Credit limit (0 = no limit)" Style="{StaticResource Label}"/>
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding CreditLimit, Converter={StaticResource Dec}}"/>
                </StackPanel>
            </Grid>
            <DockPanel Margin="0,14,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add delivery address" Command="{Binding AddAddressCommand}"/>
                <TextBlock Text="Delivery addresses" Style="{StaticResource Label}"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Addresses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Foreground="{StaticResource ErrorFg}"
                                            Command="{Binding DataContext.RemoveAddressCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <CheckBox DockPanel.Dock="Right" Content="Default" IsChecked="{Binding IsDefault}" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding Label}" Width="140" HorizontalAlignment="Left" ToolTip="Label (Home, Office, Site…)"/>
                                </DockPanel>
                                <TextBox Text="{Binding Address}" Margin="0,6,0,0" ToolTip="Address"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Landmark}" ToolTip="Landmark"/>
                                    <TextBox Grid.Column="2" Text="{Binding City}" ToolTip="City"/>
                                    <TextBox Grid.Column="4" Text="{Binding Pincode}" ToolTip="PIN code" MaxLength="6"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="0,8,0,4"/>
            <TextBox Text="{Binding Notes}" Style="{StaticResource MultilineBox}" MinHeight="48"/>
        </StackPanel>
    </DataTemplate>

    <!-- =================================================================== Customer detail -->
    <DataTemplate DataType="{x:Type vm:CustomerDetailViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,12" Focusable="False"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="New invoice" Command="{Binding NewInvoiceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Visibility="{Binding CanSell, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="New quotation" Command="{Binding NewQuotationCommand}" Margin="0,0,8,8"/>
                        <Button Content="New sales order" Command="{Binding NewOrderCommand}" Margin="0,0,8,8"/>
                        <Button Content="Receive payment" Command="{Binding ReceivePaymentCommand}" Margin="0,0,8,8" Visibility="{Binding CanReceive, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="WhatsApp reminder" Command="{Binding ReminderCommand}" Margin="0,0,8,8" Style="{StaticResource SuccessButton}"
                                Visibility="{Binding Summary.Outstanding, Converter={StaticResource NullToVis}}"/>
                        <Button Content="Refund advance" Command="{Binding RefundAdvanceCommand}" Margin="0,0,8,8" Visibility="{Binding CanRefundAdvance, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Ledger" Command="{Binding OpenLedgerCommand}" Margin="0,0,8,8"/>
                        <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,8" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <c:ResponsiveTiles MinTileWidth="210">
                        <c:KpiCard Title="Total purchases" Value="{Binding Summary.TotalPurchases, Converter={StaticResource Money}}" Note="{Binding Summary.InvoiceCount, StringFormat={}{0} invoices}" Icon="&#xE7BF;"/>
                        <c:KpiCard Title="Total paid" Value="{Binding Summary.TotalPaid, Converter={StaticResource Money}}" Note="Net of refunds" Icon="&#xE8C7;" Tone="SUCCESS"/>
                        <c:KpiCard Title="Outstanding" Value="{Binding Summary.Outstanding, Converter={StaticResource Money}}" Note="Balance due on invoices" Icon="&#xE7BA;" Tone="WARNING"/>
                        <c:KpiCard Title="Advance held" Value="{Binding Summary.AdvanceAmount, Converter={StaticResource Money}}" Note="{Binding Summary.OpenOrderCount, StringFormat={}{0} open orders}" Icon="&#xE72E;" Tone="INFO"/>
                    </c:ResponsiveTiles>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                        <WrapPanel>
                            <StackPanel Margin="0,0,40,6" MinWidth="220">
                                <TextBlock Text="CONTACT" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Mobile:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Customer.Mobile, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="WhatsApp:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Customer.Whatsapp, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Email:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Customer.Email, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="GSTIN:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Customer.Gstin, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,40,6" MaxWidth="380">
                                <TextBlock Text="BILLING ADDRESS" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding Customer.BillingAddress}"/>
                                <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Customer.City, Mode=OneWay}"/> <Run Text="{Binding Customer.State, Mode=OneWay}"/> <Run Text="{Binding Customer.Pincode, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                            <StackPanel MaxWidth="380">
                                <TextBlock Text="DELIVERY ADDRESSES" Style="{StaticResource Label}"/>
                                <ItemsControl ItemsSource="{Binding Customer.Addresses}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Value}" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12" Padding="12,4,12,12">
                        <TabControl>
                            <TabItem Header="Invoices">
                                <DataGrid ItemsSource="{Binding Invoices}" MaxHeight="420" c:GridBehaviors.OpenCommand="{Binding OpenInvoiceCommand}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Invoice" Binding="{Binding DisplayNumber}" Width="140" ElementStyle="{StaticResource BoldCell}"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, Converter={StaticResource Date}}" Width="110"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, Converter={StaticResource Money}}" Width="*" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTextColumn Header="Paid" Binding="{Binding Paid, Converter={StaticResource Money}}" Width="*" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, Converter={StaticResource Money}}" Width="*" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTemplateColumn Header="Status" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding PaymentState}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Payments">
                                <DataGrid ItemsSource="{Binding Payments}" MaxHeight="420" c:GridBehaviors.OpenCommand="{Binding OpenPaymentCommand}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Receipt" Binding="{Binding Number}" Width="140" ElementStyle="{StaticResource BoldCell}"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, Converter={StaticResource Date}}" Width="110"/>
                                        <DataGridTextColumn Header="Mode" Binding="{Binding Methods}" Width="*"/>
                                        <DataGridTextColumn Header="Applied to" Binding="{Binding AppliedTo}" Width="*"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Money}}" Width="130" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTemplateColumn Header="Status" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding State}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Quotations">
                                <DataGrid ItemsSource="{Binding Quotations}" MaxHeight="420" c:GridBehaviors.OpenCommand="{Binding OpenQuotationCommand}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Quotation" Binding="{Binding Number}" Width="140" ElementStyle="{StaticResource BoldCell}"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource Date}}" Width="110"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, Converter={StaticResource Money}}" Width="*" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTemplateColumn Header="Status" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Sales orders">
                                <DataGrid ItemsSource="{Binding Orders}" MaxHeight="420" c:GridBehaviors.OpenCommand="{Binding OpenOrderCommand}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order" Binding="{Binding Number}" Width="140" ElementStyle="{StaticResource BoldCell}"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource Date}}" Width="110"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, Converter={StaticResource Money}}" Width="*" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTextColumn Header="Advance" Binding="{Binding AdvancePaid, Converter={StaticResource Money}}" Width="*" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTemplateColumn Header="Status" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Custom orders">
                                <DataGrid ItemsSource="{Binding CustomOrders}" MaxHeight="420" c:GridBehaviors.OpenCommand="{Binding OpenCustomOrderCommand}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order" Binding="{Binding Number}" Width="130" ElementStyle="{StaticResource BoldCell}"/>
                                        <DataGridTextColumn Header="Product" Binding="{Binding ProductType}" Width="*"/>
                                        <DataGridTextColumn Header="Due" Binding="{Binding ExpectedCompletionDate, Converter={StaticResource Date}}" Width="110"/>
                                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, Converter={StaticResource Money}}" Width="130" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTemplateColumn Header="Status" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Deliveries">
                                <DataGrid ItemsSource="{Binding Deliveries}" MaxHeight="420" c:GridBehaviors.OpenCommand="{Binding OpenDeliveryCommand}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Delivery" Binding="{Binding Number}" Width="130" ElementStyle="{StaticResource BoldCell}"/>
                                        <DataGridTextColumn Header="For" Binding="{Binding SourceNumber}" Width="130"/>
                                        <DataGridTextColumn Header="Items" Binding="{Binding ItemsSummary}" Width="*"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding ScheduledDate, Converter={StaticResource Date}, ConverterParameter=dash}" Width="110"/>
                                        <DataGridTemplateColumn Header="Status" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Returns">
                                <DataGrid ItemsSource="{Binding Returns}" MaxHeight="420">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Return" Binding="{Binding Number}" Width="130" ElementStyle="{StaticResource BoldCell}"/>
                                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="130"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding ReturnDate, Converter={StaticResource Date}}" Width="110"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Converter={StaticResource StatusLabel}}" Width="*"/>
                                        <DataGridTextColumn Header="Credit" Binding="{Binding CreditAmount, Converter={StaticResource Money}}" Width="130" ElementStyle="{StaticResource RightCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Ledger">
                                <DataGrid ItemsSource="{Binding Ledger}" MaxHeight="420">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource Date}}" Width="105"/>
                                        <DataGridTextColumn Header="Document" Binding="{Binding DocNumber}" Width="130"/>
                                        <DataGridTextColumn Header="Particulars" Binding="{Binding Particulars}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                                        <DataGridTextColumn Header="Debit" Binding="{Binding Debit, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTextColumn Header="Credit" Binding="{Binding Credit, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Ledger -->
    <DataTemplate DataType="{x:Type vm:LedgerViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,14" Focusable="False"/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Width="320" Margin="0,0,12,6">
                    <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Find customer"/>
                    <ItemsControl ItemsSource="{Binding CustomerResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="8,4"
                                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding Mobile, Mode=OneWay}"/></TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <DatePicker SelectedDate="{Binding From}" Width="140" Margin="0,0,8,6" ToolTip="From"/>
                <DatePicker SelectedDate="{Binding To}" Width="140" Margin="0,0,12,6" ToolTip="To"/>
                <Menu Background="Transparent" VerticalAlignment="Top" Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}">
                    <MenuItem Header="Export ▾" FontWeight="SemiBold" Padding="10,8">
                        <MenuItem Header="Excel" Command="{Binding ExportCommand}" CommandParameter="excel"/>
                        <MenuItem Header="PDF" Command="{Binding ExportCommand}" CommandParameter="pdf"/>
                        <MenuItem Header="CSV" Command="{Binding ExportCommand}" CommandParameter="csv"/>
                    </MenuItem>
                </Menu>
            </WrapPanel>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Entries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource Date}}" Width="105"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding DocType, Converter={StaticResource StatusLabel}}" Width="90"/>
                            <DataGridTextColumn Header="Document" Binding="{Binding DocNumber}" Width="130"/>
                            <DataGridTextColumn Header="Particulars" Binding="{Binding Particulars}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Debit" Binding="{Binding Debit, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, Converter={StaticResource Money}}" Width="130" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Title="Select a customer" Message="Search above to see the customer's complete account." Icon="&#xE716;"
                                  Visibility="{Binding Customer, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding Customer, Converter={StaticResource NullToVis}}">
                <TextBlock Margin="0,0,24,0"><Run Text="Customer:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Customer.Name, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                <TextBlock Margin="0,0,24,0"><Run Text="Debits:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding TotalDebit, Converter={StaticResource Money}, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,0,24,0"><Run Text="Credits:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding TotalCredit, Converter={StaticResource Money}, Mode=OneWay}"/></TextBlock>
                <TextBlock FontWeight="Bold"><Run Text="Closing balance:"/> <Run Text="{Binding Closing, Converter={StaticResource Money}, Mode=OneWay}"/></TextBlock>
            </WrapPanel>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Outstanding -->
    <DataTemplate DataType="{x:Type vm:OutstandingViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Border DockPanel.Dock="Right" Style="{StaticResource SoftPanel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="TOTAL OUTSTANDING" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding TotalOutstanding, Converter={StaticResource Money}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ErrorFg}"/>
                    </StackPanel>
                </Border>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Customer" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerMobile}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding Number}" Width="140"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, Converter={StaticResource Date}}" Width="105"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding DueDate, Converter={StaticResource Date}}" Width="105"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, Converter={StaticResource Money}}" Width="115" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding Paid, Converter={StaticResource Money}}" Width="115" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="Status" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding PaymentState}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Collect" MinHeight="30" Margin="0,0,6,0" Padding="10,0"
                                                    Command="{Binding DataContext.CollectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="Remind" MinHeight="30" Style="{StaticResource SuccessButton}" Padding="10,0"
                                                    Command="{Binding DataContext.RemindCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Title="No outstanding payments" Message="Every invoice is fully paid." Icon="&#xE73E;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
