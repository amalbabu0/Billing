    <!-- Shared: invoice finder + return lines (returns and exchanges) -->
    <DataTemplate x:Key="InvoicePickerAndLines">
        <StackPanel>
            <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="1. Original invoice" Style="{StaticResource SectionTitle}"/>
                    <TextBox Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                             AutomationProperties.Name="Find invoice by number, customer or mobile"/>
                    <TextBlock Text="Type the invoice number, customer name or mobile" Style="{StaticResource Muted}" Margin="0,4,0,6"/>
                    <ItemsControl ItemsSource="{Binding InvoiceResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="8,4"
                                        Command="{Binding DataContext.PickInvoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock><Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding CustomerName, Mode=OneWay}"/> ·
                                        <Run Text="{Binding InvoiceDate, Converter={StaticResource Date}, Mode=OneWay}"/> · <Run Text="{Binding GrandTotal, Converter={StaticResource Money}, Mode=OneWay}"/></TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource SoftPanel}" Margin="0,8,0,0" Visibility="{Binding Invoice, Converter={StaticResource NullToVis}}">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Invoice.Number, Mode=OneWay}" FontWeight="Bold"/> · <Run Text="{Binding Invoice.CustomerName, Mode=OneWay}"/> ·
                            <Run Text="{Binding Invoice.Date, Converter={StaticResource Date}, Mode=OneWay}"/> · total <Run Text="{Binding Invoice.GrandTotal, Converter={StaticResource Money}, Mode=OneWay}"/>
                            · paid <Run Text="{Binding Invoice.Paid, Converter={StaticResource Money}, Mode=OneWay}"/> · balance <Run Text="{Binding Invoice.Balance, Converter={StaticResource Money}, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12" Visibility="{Binding Invoice, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Text="2. Items coming back" Style="{StaticResource SectionTitle}"/>
                    <DataGrid ItemsSource="{Binding ReturnLines}" IsReadOnly="False" RowHeight="46" SelectionUnit="Cell">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Line.Description}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Returnable" Binding="{Binding Max, Converter={StaticResource Qty}}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTemplateColumn Header="Qty returning" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBox Text="{Binding Quantity, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=300}" Style="{StaticResource NumberBox}" MinHeight="30"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Condition" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" MinHeight="30"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Stock action" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding RestockAction, UpdateSourceTrigger=PropertyChanged}" MinHeight="30"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit, Converter={StaticResource Money}}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,10,0,0" FontSize="15" HorizontalAlignment="Right">
                        <Run Text="Credit value:"/> <Run Text="{Binding CreditTotal, Converter={StaticResource Money}, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" Text="GOOD items go back to sellable stock · DAMAGED / DEFECTIVE go to damaged stock"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- =================================================================== New return -->
    <DataTemplate DataType="{x:Type vm:ReturnEditorViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="1100" HorizontalAlignment="Left">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,14" Focusable="False"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InvoicePickerAndLines}" Focusable="False"/>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12" Visibility="{Binding Invoice, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="3. Reason and refund" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Reason" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason}"/>
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,12,10">
                                    <TextBlock Text="Return date" Style="{StaticResource Label}"/>
                                    <DatePicker SelectedDate="{Binding Date}"/>
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,12,10" Visibility="{Binding CanRefund, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Refund now" Style="{StaticResource Label}"/>
                                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding RefundAmount, Converter={StaticResource Dec}}"/>
                                    <TextBlock Style="{StaticResource Muted}"><Run Text="Max"/> <Run Text="{Binding Refundable, Converter={StaticResource Money}, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,10" Visibility="{Binding CanRefund, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Refund by" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding RefundMethod}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,12,10" Visibility="{Binding CanRefund, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Reference" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding RefundReference}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Notes}" Style="{StaticResource MultilineBox}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="The credit first reduces any balance the customer still owes on the invoice. Money paid beyond that can be refunded now; whatever is not refunded is kept as the customer's advance."/>
                            <Button Content="Save return" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="160"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Exchanges -->
    <DataTemplate DataType="{x:Type vm:ExchangeListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ New exchange" Command="{Binding NewCommand}" VerticalAlignment="Top"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Exchange" Binding="{Binding Number}" Width="130" ElementStyle="{StaticResource BoldCell}"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, Converter={StaticResource Date}}" Width="105"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Old invoice" Binding="{Binding OriginalInvoiceNumber}" Width="130"/>
                            <DataGridTextColumn Header="New invoice" Binding="{Binding NewInvoiceNumber}" Width="130"/>
                            <DataGridTextColumn Header="Returned" Binding="{Binding OldValue, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="New" Binding="{Binding NewValue, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Paid difference" Binding="{Binding Difference, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Title="No exchanges" Message="{Binding EmptyMessage}" Icon="&#xE8AB;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ExchangeEditorViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="1100" HorizontalAlignment="Left">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,14" Focusable="False"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InvoicePickerAndLines}" Focusable="False"/>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12" Visibility="{Binding Invoice, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="3. New item(s)" Style="{StaticResource SectionTitle}"/>
                            <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="420" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Search the new product"/>
                            <ItemsControl ItemsSource="{Binding ProductResults}" Margin="0,4,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="8,4"
                                                Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <TextBlock><Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding SellingPrice, Converter={StaticResource Money}, Mode=OneWay}"/> · <Run Text="{Binding Available, Converter={StaticResource Qty}, Mode=OneWay}"/> available</TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding NewLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Foreground="{StaticResource ErrorFg}"
                                                    Command="{Binding DataContext.RemoveNewLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotal, Converter={StaticResource Money}}" FontWeight="SemiBold" Width="120" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumberBox}" Width="70" Margin="8,0" Text="{Binding DiscountPercent, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=400}" ToolTip="Discount %"/>
                                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumberBox}" Width="60" Text="{Binding Quantity, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=400}" ToolTip="Quantity"/>
                                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12" Visibility="{Binding Invoice, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="4. Settle the difference" Style="{StaticResource SectionTitle}"/>
                            <Grid MaxWidth="460" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Value of returned item(s)" Margin="0,3"/>
                                <TextBlock Grid.Column="1" Text="{Binding Preview.OldValue, Converter={StaticResource Money}}" Margin="20,3,0,3"/>
                                <TextBlock Grid.Row="1" Text="Already paid, available as credit" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.CreditAvailable, Converter={StaticResource Money}}" Margin="20,3,0,3"/>
                                <TextBlock Grid.Row="2" Text="New invoice total" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NewTotal, Converter={StaticResource Money}}" Margin="20,3,0,3"/>
                                <TextBlock Grid.Row="3" Text="Customer pays" FontWeight="Bold" FontSize="16" Margin="0,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Preview.Difference, Converter={StaticResource Money}}" FontWeight="Bold" FontSize="16" Margin="20,6,0,6"
                                           Foreground="{StaticResource Primary}"/>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Width="160" Margin="0,0,12,0">
                                    <TextBlock Text="Paid by" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding PayMethod}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Width="200" Margin="0,0,12,0">
                                    <TextBlock Text="Reference" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding PayReference}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding Notes}" Style="{StaticResource MultilineBox}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="If the new item costs less, the remaining credit is kept as the customer's advance (walk-in customers are refunded in cash)."/>
                            <Button Content="Complete exchange" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="180"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
