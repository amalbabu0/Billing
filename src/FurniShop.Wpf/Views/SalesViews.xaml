                                            <StackPanel><TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Number, Mode=OneWay}"/> · <Run Text="{Binding Methods, Mode=OneWay}"/></TextBlock></StackPanel>
