<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FurniShop.Wpf.ViewModels"
                    xmlns:c="clr-namespace:FurniShop.Wpf.Controls"
                    xmlns:d="clr-namespace:FurniShop.Core.Domain;assembly=FurniShop.Core">

    <!-- Shared: items table for quotation / order / invoice -->
    <DataTemplate x:Key="LinesTable">
        <DataGrid ItemsSource="{Binding}" RowHeight="46" HeadersVisibility="Column" MaxHeight="420" AutomationProperties.Name="Items">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding LineNo}" Width="36"/>
                <DataGridTemplateColumn Header="Item" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Sku, Mode=OneWay}"/> · HSN <Run Text="{Binding HsnCode, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, Converter={StaticResource Qty}}" Width="56" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Rate" Binding="{Binding UnitPrice, Converter={StaticResource Money}}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, StringFormat={}{0:0.##}}" Width="64" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableAmount, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat={}{0:0.##}%}" Width="60" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="GST" Binding="{Binding Tax, Converter={StaticResource Money}}" Width="96" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}" FontWeight="SemiBold"/>
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>

    <!-- Shared: totals block for any SalesDocument -->
    <DataTemplate x:Key="DocTotals">
        <Grid MinWidth="280">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Subtotal" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
            <TextBlock Grid.Column="1" Text="{Binding Subtotal, Converter={StaticResource Money}}" HorizontalAlignment="Right" Margin="0,3"/>
            <TextBlock Grid.Row="1" Text="Discount" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountTotal, Converter={StaticResource Money}}" HorizontalAlignment="Right" Margin="0,3"/>
            <TextBlock Grid.Row="2" Text="Delivery / installation" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
            <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Margin="0,3">
                <Run Text="{Binding DeliveryCharge, Converter={StaticResource Money}, Mode=OneWay}"/> / <Run Text="{Binding InstallationCharge, Converter={StaticResource Money}, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Grid.Row="3" Text="Taxable amount" FontWeight="SemiBold" Margin="0,3"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TaxableTotal, Converter={StaticResource Money}}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3"/>
            <TextBlock Grid.Row="4" Text="CGST + SGST" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
            <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Margin="0,3">
                <Run Text="{Binding CgstTotal, Converter={StaticResource Money}, Mode=OneWay}"/> + <Run Text="{Binding SgstTotal, Converter={StaticResource Money}, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Grid.Row="5" Text="IGST" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding IgstTotal, Converter={StaticResource Money}}" HorizontalAlignment="Right" Margin="0,3"/>
            <TextBlock Grid.Row="6" Text="Round off" Foreground="{StaticResource TextSecondary}" Margin="0,3"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RoundOff, Converter={StaticResource Money}}" HorizontalAlignment="Right" Margin="0,3"/>
            <Border Grid.Row="7" Grid.ColumnSpan="2" Background="{StaticResource Primary}" CornerRadius="7" Padding="10,7" Margin="0,6,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotal, Converter={StaticResource Money}}" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Grand total" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding GrandTotal, Converter={StaticResource Money}, ConverterParameter=words}" Style="{StaticResource Muted}"
                       Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="320"/>
        </Grid>
    </DataTemplate>

    <!-- Shared: workflow stepper -->
    <DataTemplate x:Key="Stepper">
        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StepItem}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                        <Border x:Name="dot" Width="22" Height="22" CornerRadius="11" Background="{StaticResource NeutralBg}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
                            <TextBlock x:Name="tick" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" HorizontalAlignment="Center" Visibility="Collapsed" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="lbl" Text="{Binding Label}" Margin="6,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="›" Foreground="{StaticResource BorderStrong}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Done}" Value="True">
                            <Setter TargetName="dot" Property="Background" Value="{StaticResource SuccessFg}"/>
                            <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource SuccessFg}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="lbl" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Current}" Value="True">
                            <Setter TargetName="dot" Property="Background" Value="{StaticResource Primary}"/>
                            <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            <Setter TargetName="lbl" Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- Shared: payments list (compact) -->
    <DataTemplate x:Key="PaymentsTable">
        <DataGrid ItemsSource="{Binding}" RowHeight="40" MaxHeight="300" AutomationProperties.Name="Payments"
                  c:GridBehaviors.OpenCommand="{Binding DataContext.OpenPaymentCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Receipt" Binding="{Binding Number}" Width="130"/>
                <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, Converter={StaticResource Date}}" Width="100"/>
                <DataGridTextColumn Header="Mode" Binding="{Binding Methods}" Width="*"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTemplateColumn Header="Status" Width="110">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding State}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>

    <!-- =================================================================== Invoice list -->
    <DataTemplate DataType="{x:Type vm:InvoiceListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ New invoice (F2)" Command="{Binding DataContext.NewInvoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        VerticalAlignment="Top"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <c:AdaptiveList>
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.ServerSort="True"
                                  c:GridBehaviors.OpenCommand="{Binding OpenCommand}" AutomationProperties.Name="Invoices">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding DisplayNumber}" SortMemberPath="number" Width="150" ElementStyle="{StaticResource BoldCell}"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, Converter={StaticResource Date}}" SortMemberPath="date" Width="110"/>
                                <DataGridTemplateColumn Header="Customer" SortMemberPath="customer" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CustomerMobile}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, Converter={StaticResource Money}}" SortMemberPath="total" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="Paid" Binding="{Binding Paid, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTemplateColumn Header="Balance" SortMemberPath="balance" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Balance, Converter={StaticResource Money}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{Binding Balance, Converter={StaticResource BalanceBrush}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Due" Binding="{Binding DueDate, Converter={StaticResource Date}}" SortMemberPath="due" Width="105"/>
                                <DataGridTemplateColumn Header="Status" Width="140">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding PaymentState}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding GrandTotal, Converter={StaticResource Money}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                <c:StatusBadge Status="{Binding PaymentState}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayNumber}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CustomerName}"/>
                                                <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding InvoiceDate, Converter={StaticResource Date}, Mode=OneWay}"/> · Balance <Run Text="{Binding Balance, Converter={StaticResource Money}, Mode=OneWay}"/></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </c:AdaptiveList>
                    <c:EmptyState Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}" Icon="&#xE8A5;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Invoice detail -->
    <DataTemplate DataType="{x:Type vm:InvoiceDetailViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <DockPanel Margin="0,0,0,14">
                        <c:StatusBadge DockPanel.Dock="Right" Status="{Binding Invoice.PaymentState}" VerticalAlignment="Top" Margin="10,6,0,0"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
                    </DockPanel>

                    <!-- action bar -->
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="Print A4" Command="{Binding PrintCommand}" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Print thermal" Command="{Binding PrintThermalCommand}" Margin="0,0,8,8"/>
                        <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,8"/>
                        <Button Content="PDF" Command="{Binding PdfCommand}" Margin="0,0,8,8"/>
                        <Button Content="WhatsApp" Command="{Binding WhatsAppCommand}" Margin="0,0,8,8" Style="{StaticResource SuccessButton}"/>
                        <Button Content="Receive payment" Command="{Binding ReceivePaymentCommand}" Margin="0,0,8,8" Visibility="{Binding CanReceive, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Send reminder" Command="{Binding ReminderCommand}" Margin="0,0,8,8" Visibility="{Binding CanReceive, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Refund excess" Command="{Binding RefundCommand}" Margin="0,0,8,8" Visibility="{Binding CanRefund, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Create delivery" Command="{Binding CreateDeliveryCommand}" Margin="0,0,8,8" Visibility="{Binding CanDeliver, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Return" Command="{Binding NewReturnCommand}" Margin="0,0,8,8" Visibility="{Binding CanReturn, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Exchange" Command="{Binding NewExchangeCommand}" Margin="0,0,8,8" Visibility="{Binding CanReturn, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Cancel invoice" Command="{Binding CancelInvoiceCommand}" Margin="0,0,8,8" Style="{StaticResource DangerButton}"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,14" Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SoftPanel}" Margin="0,0,10,8">
                            <TextBlock Text="Draft — no invoice number yet and stock is not reduced. Finalise it to bill the customer." TextWrapping="Wrap" MaxWidth="480"/>
                        </Border>
                        <Button Content="Finalise" Style="{StaticResource PrimaryButton}" Command="{Binding FinalizeDraftCommand}" Margin="0,0,8,8"/>
                        <Button Content="Edit draft" Command="{Binding EditDraftCommand}" Margin="0,0,8,8"/>
                        <Button Content="Delete draft" Command="{Binding DeleteDraftCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <Border Background="{StaticResource ErrorBg}" CornerRadius="8" Padding="12" Margin="0,0,0,14"
                            Visibility="{Binding Invoice.CancelReason, Converter={StaticResource NullToVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ErrorFg}">
                            <Run Text="Cancelled" FontWeight="Bold"/> <Run Text="{Binding Invoice.CancelledAt, Converter={StaticResource Date}, ConverterParameter=time, Mode=OneWay}"/>
                            <Run Text="by"/> <Run Text="{Binding Invoice.CancelledByName, Mode=OneWay}"/> — <Run Text="{Binding Invoice.CancelReason, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <c:ResponsiveTiles MinTileWidth="260">
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="CUSTOMER" Style="{StaticResource Label}"/>
                                <Button Style="{StaticResource LinkButton}" Content="{Binding Invoice.CustomerName}" Command="{Binding OpenCustomerCommand}" FontSize="15"/>
                                <TextBlock Text="{Binding Invoice.CustomerMobile}" Style="{StaticResource Value}"/>
                                <TextBlock Text="{Binding Invoice.CustomerGstin, StringFormat='GSTIN {0}'}" Style="{StaticResource Muted}"
                                           Visibility="{Binding Invoice.CustomerGstin, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding Invoice.BillingAddress}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="DETAILS" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Date:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Invoice.Date, Converter={StaticResource Date}, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Due:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Invoice.DueDate, Converter={StaticResource Date}, ConverterParameter=dash, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Place of supply:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Invoice.PlaceOfSupply, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Billed by:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Invoice.CreatedByName, Mode=OneWay}"/></TextBlock>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding OpenSalesOrderCommand}" Content="{Binding Invoice.SalesOrderNumber}" ContentStringFormat="From sales order {0}"
                                        Visibility="{Binding Invoice.SalesOrderNumber, Converter={StaticResource NullToVis}}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="PAYMENT" Style="{StaticResource Label}"/>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.GrandTotal, Converter={StaticResource Money}}"/><TextBlock Text="Total" Foreground="{StaticResource TextSecondary}"/></DockPanel>
                                <DockPanel Visibility="{Binding Invoice.ReturnedAmount, Converter={StaticResource NullToVis}}"><TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.ReturnedAmount, Converter={StaticResource Money}}"/><TextBlock Text="Returned" Foreground="{StaticResource TextSecondary}"/></DockPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.Paid, Converter={StaticResource Money}}" Foreground="{StaticResource SuccessFg}"/><TextBlock Text="Paid" Foreground="{StaticResource TextSecondary}"/></DockPanel>
                                <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.Balance, Converter={StaticResource Money}}" FontSize="18" FontWeight="Bold"
                                                                         Foreground="{Binding Invoice.Balance, Converter={StaticResource BalanceBrush}}"/><TextBlock Text="Balance" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                <DockPanel Visibility="{Binding CanSeeCost, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.Margin, Converter={StaticResource Money}, ConverterParameter=dash}"/><TextBlock Text="Margin (ex-GST)" Style="{StaticResource Muted}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </c:ResponsiveTiles>

                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Items" Style="{StaticResource SectionTitle}"/>
                            <ContentControl Content="{Binding Invoice.Lines}" ContentTemplate="{StaticResource LinesTable}" Focusable="False"/>
                            <ContentControl Content="{Binding Invoice}" ContentTemplate="{StaticResource DocTotals}" HorizontalAlignment="Right" Margin="0,12,0,0" Focusable="False"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12" Visibility="{Binding Payments.Count, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="Payment history" Style="{StaticResource SectionTitle}"/>
                            <ContentControl Content="{Binding Payments}" ContentTemplate="{StaticResource PaymentsTable}" Focusable="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12" Visibility="{Binding Deliveries.Count, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="Deliveries" Style="{StaticResource SectionTitle}"/>
                            <DataGrid ItemsSource="{Binding Deliveries}" MaxHeight="200" c:GridBehaviors.OpenCommand="{Binding OpenDeliveryCommand}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Delivery" Binding="{Binding Number}" Width="140"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding ScheduledDate, Converter={StaticResource Date}, ConverterParameter=dash}" Width="110"/>
                                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="*"/>
                                    <DataGridTemplateColumn Header="Status" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12" Visibility="{Binding Returns.Count, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="Returns (credit notes)" Style="{StaticResource SectionTitle}"/>
                            <DataGrid ItemsSource="{Binding Returns}" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Return" Binding="{Binding Number}" Width="140"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding ReturnDate, Converter={StaticResource Date}}" Width="110"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Converter={StaticResource StatusLabel}}" Width="*"/>
                                    <DataGridTextColumn Header="Credit" Binding="{Binding CreditAmount, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Refunded" Binding="{Binding RefundAmount, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12" Visibility="{Binding History.Count, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="Audit history" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,3" TextWrapping="Wrap">
                                            <Run Text="{Binding OccurredAt, Converter={StaticResource Date}, ConverterParameter=time, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                                            <Run Text="  "/><Run Text="{Binding Summary, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Quotation list -->
    <DataTemplate DataType="{x:Type vm:QuotationListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ New quotation" Command="{Binding NewCommand}" VerticalAlignment="Top"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}" AutomationProperties.Name="Quotations">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quotation" Binding="{Binding Number}" Width="150" ElementStyle="{StaticResource BoldCell}"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource Date}}" Width="110"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Valid until" Binding="{Binding ValidUntil, Converter={StaticResource Date}}" Width="110"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, Converter={StaticResource Money}}" Width="130" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Sales order" Binding="{Binding SalesOrderNumber}" Width="130"/>
                            <DataGridTemplateColumn Header="Status" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Title="No quotations" Message="{Binding EmptyMessage}" Icon="&#xE8A5;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Quotation detail -->
    <DataTemplate DataType="{x:Type vm:QuotationDetailViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <DockPanel Margin="0,0,0,14">
                        <c:StatusBadge DockPanel.Dock="Right" Status="{Binding Quotation.Status}" VerticalAlignment="Top" Margin="10,6,0,0"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="Print" Command="{Binding PrintCommand}" Margin="0,0,8,8"/>
                        <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,8"/>
                        <Button Content="PDF" Command="{Binding PdfCommand}" Margin="0,0,8,8"/>
                        <Button Content="WhatsApp" Command="{Binding WhatsAppCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,8"/>
                        <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,8" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Mark sent" Command="{Binding SetStatusCommand}" CommandParameter="SENT" Margin="0,0,8,8" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Customer confirmed" Command="{Binding SetStatusCommand}" CommandParameter="CONFIRMED" Margin="0,0,8,8" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Rejected" Command="{Binding SetStatusCommand}" CommandParameter="REJECTED" Margin="0,0,8,8" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>
