    <!-- =================================================================== Sales order detail -->
    <DataTemplate DataType="{x:Type vm:SalesOrderDetailViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <DockPanel Margin="0,0,0,10">
                        <c:StatusBadge DockPanel.Dock="Right" Status="{Binding Order.Status}" VerticalAlignment="Top" Margin="10,6,0,0"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
                    </DockPanel>
                    <ContentControl Content="{Binding Steps}" ContentTemplate="{StaticResource Stepper}" Margin="0,0,0,12" Focusable="False"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Confirm order" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Collect advance" Command="{Binding CollectAdvanceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Visibility="{Binding CanAdvance, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding NextStatusLabel}" Command="{Binding AdvanceStatusCommand}" Margin="0,0,8,8" Visibility="{Binding NextStatus, Converter={StaticResource NullToVis}}"/>
                        <Button Content="Generate invoice" Command="{Binding GenerateInvoiceCommand}" Margin="0,0,8,8" Style="{StaticResource SuccessButton}" Visibility="{Binding CanInvoice, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Schedule delivery" Command="{Binding ScheduleDeliveryCommand}" Margin="0,0,8,8" Visibility="{Binding CanDeliver, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Reserve stock again" Command="{Binding ReserveCommand}" Margin="0,0,8,8" Visibility="{Binding HasShortage, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,8" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Print" Command="{Binding PrintCommand}" Margin="0,0,8,8"/>
                        <Button Content="PDF" Command="{Binding PdfCommand}" Margin="0,0,8,8"/>
                        <Button Content="WhatsApp" Command="{Binding WhatsAppCommand}" Margin="0,0,8,8"/>
                        <Button Content="Open invoice" Command="{Binding OpenInvoiceCommand}" Margin="0,0,8,8" Visibility="{Binding Order.InvoiceId, Converter={StaticResource NullToVis}}"/>
                        <Button Content="Cancel order" Command="{Binding CancelOrderCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <Border Background="{StaticResource WarningBg}" CornerRadius="8" Padding="12" Margin="0,0,12,12" Visibility="{Binding HasShortage, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningFg}"
                                   Text="Some items are not fully reserved (see the Reserved column). Purchase or manufacture them, then use 'Reserve stock again'."/>
                    </Border>
                    <c:ResponsiveTiles MinTileWidth="260">
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="CUSTOMER" Style="{StaticResource Label}"/>
                                <Button Style="{StaticResource LinkButton}" Content="{Binding Order.CustomerName}" Command="{Binding OpenCustomerCommand}" FontSize="15"/>
                                <TextBlock Text="{Binding Order.CustomerMobile}" Style="{StaticResource Value}"/>
                                <TextBlock Text="{Binding Order.DeliveryAddress}" Style="{StaticResource Muted}"/>
                                <Button Style="{StaticResource LinkButton}" Content="{Binding Order.QuotationNumber}" ContentStringFormat="From quotation {0}" Command="{Binding OpenQuotationCommand}"
                                        Visibility="{Binding Order.QuotationNumber, Converter={StaticResource NullToVis}}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="MONEY" Style="{StaticResource Label}"/>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Order.GrandTotal, Converter={StaticResource Money}}"/><TextBlock Text="Order value" Foreground="{StaticResource TextSecondary}"/></DockPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Order.AdvancePaid, Converter={StaticResource Money}}" Foreground="{StaticResource SuccessFg}"/><TextBlock Text="Advance / paid" Foreground="{StaticResource TextSecondary}"/></DockPanel>
                                <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Order.Balance, Converter={StaticResource Money}}" FontSize="18" FontWeight="Bold"
                                                                         Foreground="{Binding Order.Balance, Converter={StaticResource BalanceBrush}}"/><TextBlock Text="Balance" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="DELIVERY" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Expected:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Order.ExpectedDeliveryDate, Converter={StaticResource Date}, ConverterParameter=dash, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Home delivery:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Order.RequiresDelivery, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Installation:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Order.RequiresInstallation, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Border>
                    </c:ResponsiveTiles>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Items" Style="{StaticResource SectionTitle}"/>
                            <DataGrid ItemsSource="{Binding Order.Lines}" RowHeight="46" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Item" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Sku}" Style="{StaticResource Muted}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, Converter={StaticResource Qty}}" Width="60" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQty, Converter={StaticResource Qty}}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Rate" Binding="{Binding UnitPrice, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, StringFormat={}{0:0.##}}" Width="64" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="GST" Binding="{Binding Tax, Converter={StaticResource Money}}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ContentControl Content="{Binding Order}" ContentTemplate="{StaticResource DocTotals}" HorizontalAlignment="Right" Margin="0,12,0,0" Focusable="False"/>
                        </StackPanel>
                    </Border>
                    <c:ResponsiveTiles MinTileWidth="420">
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Advances &amp; payments" Style="{StaticResource SectionTitle}"/>
                                <ContentControl Content="{Binding Payments}" ContentTemplate="{StaticResource PaymentsTable}" Focusable="False"/>
                                <TextBlock Text="No advance received yet." Style="{StaticResource Muted}" Visibility="{Binding Payments.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Status history" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <c:StatusBadge DockPanel.Dock="Left" Status="{Binding ToStatus}" Margin="0,0,10,0"/>
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding ChangedAt, Converter={StaticResource Date}, ConverterParameter=time, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                                                    <Run Text="{Binding ChangedByName, Mode=OneWay}"/> <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </c:ResponsiveTiles>
                </StackPanel>
            </ScrollViewer>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>

