                        </WrapPanel>
                    </Border>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Value}" Margin="0,0,0,10">
                                <Run Text="{Binding Quotation.CustomerName, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding Quotation.CustomerMobile, Mode=OneWay}"/>
                                · prepared by <Run Text="{Binding Quotation.CreatedByName, Mode=OneWay}"/>
                            </TextBlock>
                            <ContentControl Content="{Binding Quotation.Lines}" ContentTemplate="{StaticResource LinesTable}" Focusable="False"/>
