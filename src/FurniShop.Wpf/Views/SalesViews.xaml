                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Receipt" Binding="{Binding Number}" Width="140" ElementStyle="{StaticResource BoldCell}"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, Converter={StaticResource Date}}" Width="105"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Mode" Binding="{Binding Methods}" Width="190"/>
                                <DataGridTextColumn Header="Applied to" Binding="{Binding AppliedTo}" Width="170"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
