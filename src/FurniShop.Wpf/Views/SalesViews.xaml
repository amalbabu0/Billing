                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding Quotation.Notes}" Style="{StaticResource Value}"/>
                                    <TextBlock Text="Terms" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                    <TextBlock Text="{Binding Quotation.Terms}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
