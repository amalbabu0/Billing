<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FurniShop.Wpf.ViewModels"
                    xmlns:c="clr-namespace:FurniShop.Wpf.Controls">

    <Style x:Key="SumLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style x:Key="SumValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>

    <DataTemplate DataType="{x:Type vm:SalesEditorViewModel}">
        <Grid Margin="16,14,16,14">
            <Grid.InputBindings>
                <KeyBinding Key="F8" Command="{Binding SaveDraftCommand}"/>
                <KeyBinding Key="F9" Command="{Binding SavePrintCommand}"/>
                <KeyBinding Key="F10" Command="{Binding SavePdfCommand}"/>
                <KeyBinding Key="F11" Command="{Binding SaveWhatsAppCommand}"/>
            </Grid.InputBindings>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260" MaxWidth="400"/>
                <ColumnDefinition Width="5*" MinWidth="360"/>
                <ColumnDefinition Width="3.2*" MinWidth="310" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- title -->
            <DockPanel Grid.ColumnSpan="3" Margin="4,0,4,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Text="F4 scan · F6 customer · F8 draft · F9 save &amp; print · F10 PDF · F11 WhatsApp"/>
                    <Button Style="{StaticResource GhostButton}" Content="Clear" Command="{Binding ClearCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="20"/>
            </DockPanel>

            <!-- ====================================== LEFT: products -->
            <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}" Padding="32,0,8,0" c:FocusBehavior.Shortcut="F4" c:FocusBehavior.FocusOnLoad="True"
                                 AutomationProperties.Name="Scan barcode or type SKU and press Enter">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ScanCommand}"/></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" FontSize="14" Foreground="{StaticResource Primary}" Margin="10,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                        <TextBlock Text="Scan barcode / SKU + Enter (F4)" Foreground="{StaticResource TextMuted}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding ScanCode, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}" Padding="32,0,8,0" AutomationProperties.Name="Search products"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="11,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                        <TextBlock Text="Search furniture…" Foreground="{StaticResource TextMuted}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding ProductSearch, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                    </Grid>
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8" AutomationProperties.Name="Categories">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="14" Padding="10,4" Margin="0,0,6,6" BorderThickness="1" BorderBrush="{StaticResource Border}" Background="{StaticResource Surface}">
                                                <TextBlock x:Name="t" Text="{Binding Name}" FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Primary}"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                                    <Setter TargetName="t" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,6"
                                            ToolTip="Click to add to the bill" AutomationProperties.Name="{Binding DisplayName}">
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,8" Background="{StaticResource Surface}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding SellingPrice, Converter={StaticResource Money}}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                                                    <c:StatusBadge Status="{Binding StockState}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource Muted}" FontWeight="Normal">
                                                        <Run Text="{Binding Sku, Mode=OneWay}"/> · <Run Text="{Binding Available, Converter={StaticResource Qty}, Mode=OneWay}"/> <Run Text="available"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Material}" Style="{StaticResource Muted}" FontWeight="Normal"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ====================================== CENTRE: items -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatCard}" Padding="0" Margin="0,0,10,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding AddCustomLineCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="Custom item / service"/></StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14">
                            <Run Text="Items"/> <Run Text="(" Foreground="{StaticResource TextMuted}"/><Run Text="{Binding Lines.Count, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/><Run Text=")" Foreground="{StaticResource TextMuted}"/>
                        </TextBlock>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,1" Padding="14,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="96"/><ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/><ColumnDefinition Width="100"/><ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Item" Style="{StaticResource Label}" Margin="0"/>
                            <TextBlock Grid.Column="1" Text="Qty" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Rate" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Disc %" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="GST" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="Amount" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <c:EmptyState Title="No items yet" Icon="&#xE7BF;" Message="Scan a barcode, search, or click a product on the left to add it."
                                      Visibility="{Binding HasLines, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="14,4,14,10" KeyboardNavigation.TabNavigation="Continue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EditorLine}">
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="96"/><ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="70"/><ColumnDefinition Width="100"/><ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" MinHeight="30" FontWeight="SemiBold" BorderThickness="0" Padding="2,0"
                                                             Background="Transparent" AutomationProperties.Name="Item description"/>
                                                    <TextBlock Style="{StaticResource Muted}" Margin="2,1,0,0">
                                                        <Run Text="{Binding Sku, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding StockText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="⚠ More than available stock" Foreground="{StaticResource WarningFg}" FontSize="12" Margin="2,2,0,0"
                                                               Visibility="{Binding StockWarning, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding LineError}" Style="{StaticResource FieldError}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE738;" Width="28" MinHeight="30" FontSize="11" ToolTip="Decrease"
                                                            Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="Decrease quantity"/>
                                                    <TextBox Text="{Binding Quantity, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="46" MinHeight="30"
                                                             TextAlignment="Center" Padding="2,0" AutomationProperties.Name="Quantity"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Width="28" MinHeight="30" FontSize="11" ToolTip="Increase"
                                                            Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="Increase quantity"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="2" Text="{Binding UnitPrice, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                                         Style="{StaticResource NumberBox}" MinHeight="30" Margin="4,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Rate"/>
                                                <TextBox Grid.Column="3" Text="{Binding DiscountPercent, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                                         Style="{StaticResource NumberBox}" MinHeight="30" Margin="4,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Discount percent"/>
                                                <ComboBox Grid.Column="4" ItemsSource="{Binding DataContext.GstRates, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding GstRate}" ItemStringFormat="{}{0:0.##}%" MinHeight="30" Margin="4,0,0,0" VerticalAlignment="Top"
                                                          AutomationProperties.Name="GST rate"/>
                                                <TextBlock Grid.Column="5" Text="{Binding LineTotal, Converter={StaticResource Money}}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                                <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="28" MinHeight="30" FontSize="13" VerticalAlignment="Top"
                                                        Foreground="{StaticResource ErrorFg}" ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Remove item"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ====================================== RIGHT: customer, totals, payment -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatCard}" Padding="0">
                <DockPanel>
                    <!-- final buttons -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel>
                            <Grid Visibility="{Binding IsInvoice, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                                <Button Content="SAVE DRAFT (F8)" Command="{Binding SaveDraftCommand}"/>
                                <Button Grid.Column="2" Content="SAVE &amp; PDF (F10)" Command="{Binding SavePdfCommand}"/>
                                <Button Grid.Row="2" Content="SAVE &amp; WHATSAPP" Command="{Binding SaveWhatsAppCommand}" Style="{StaticResource SuccessButton}"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="SAVE &amp; PRINT (F9)" Command="{Binding SavePrintCommand}" Style="{StaticResource PrimaryButton}"/>
                            </Grid>
                            <Grid Visibility="{Binding IsInvoice, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                                <Button Content="SAVE &amp; PDF" Command="{Binding SavePdfCommand}"/>
                                <Button Grid.Column="2" Content="SAVE &amp; WHATSAPP" Command="{Binding SaveWhatsAppCommand}" Style="{StaticResource SuccessButton}"/>
                                <Button Grid.Row="2" Content="SAVE &amp; PRINT" Command="{Binding SavePrintCommand}"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="SAVE" Command="{Binding SaveOnlyCommand}" Style="{StaticResource PrimaryButton}"/>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,12">
                            <!-- customer -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Walk-in" Command="{Binding UseWalkInCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding IsInvoice, Converter={StaticResource BoolToVis}}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ New" Command="{Binding NewCustomerCommand}"/>
                                <TextBlock Text="CUSTOMER" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <Border Style="{StaticResource SoftPanel}" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Customer.Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding CustomerLine}" Style="{StaticResource Muted}"/>
                                    <TextBlock Style="{StaticResource Muted}" Visibility="{Binding CustomerSummary, Converter={StaticResource NullToVis}}">
                                        <Run Text="Outstanding"/> <Run Text="{Binding CustomerSummary.Outstanding, Converter={StaticResource Money}, Mode=OneWay}" Foreground="{StaticResource ErrorFg}"/>
                                        <Run Text=" · Advance"/> <Run Text="{Binding CustomerSummary.AdvanceAmount, Converter={StaticResource Money}, Mode=OneWay}" Foreground="{StaticResource SuccessFg}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,10">
                                <TextBox x:Name="CustSearch" Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,8,0" c:FocusBehavior.Shortcut="F6"
                                         AutomationProperties.Name="Search customer by name or mobile"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                                <TextBlock Text="Find customer by name / mobile (F6)" Foreground="{StaticResource TextMuted}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding CustomerSearch, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                <Popup IsOpen="{Binding IsCustomerSearchOpen}" PlacementTarget="{Binding ElementName=CustSearch}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       Width="{Binding ActualWidth, ElementName=CustSearch}">
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,10" Effect="{StaticResource PopupShadow}">
                                        <StackPanel Margin="4">
                                            <ItemsControl ItemsSource="{Binding CustomerResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="8,6"
                                                                Command="{Binding DataContext.PickCustomerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"/>
                                                                <TextBlock Text="{Binding Mobile}" Style="{StaticResource Muted}" FontWeight="Normal"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Style="{StaticResource LinkButton}" Content="+ Add as new customer" Margin="8,6" Command="{Binding NewCustomerCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- document options -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Date" Style="{StaticResource Label}"/>
                                    <DatePicker SelectedDate="{Binding DocumentDate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Place of supply" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding PlaceOfSupply}" DisplayMemberPath="Display" AutomationProperties.Name="Place of supply"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Visibility="{Binding IsQuotation, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="Valid until" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding ValidUntil}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsSalesOrder, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="Expected delivery" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding ExpectedDeliveryDate}"/>
                            </StackPanel>
                            <WrapPanel Margin="0,4,0,4">
                                <CheckBox Content="Home delivery" IsChecked="{Binding RequiresDelivery}" Margin="0,0,14,0"/>
                                <CheckBox Content="Installation" IsChecked="{Binding RequiresInstallation}" IsEnabled="{Binding RequiresDelivery}"/>
                            </WrapPanel>
                            <Grid Margin="0,0,0,6" Visibility="{Binding RequiresDelivery, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Delivery charge (+GST)" Style="{StaticResource Label}"/>
                                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding DeliveryCharge, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Installation (+GST)" Style="{StaticResource Label}"/>
                                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding InstallationCharge, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                             IsEnabled="{Binding RequiresInstallation}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Visibility="{Binding RequiresDelivery, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="Delivery address" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding DeliveryAddress}" Style="{StaticResource MultilineBox}" MinHeight="48"/>
                            </StackPanel>
                            <Expander Header="Notes" Margin="0,0,0,8">
                                <TextBox Text="{Binding Notes}" Style="{StaticResource MultilineBox}" MinHeight="48" Margin="0,6,0,0"/>
                            </Expander>

                            <!-- totals -->
                            <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="12,8" Margin="0,4,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Subtotal (ex-GST)" Style="{StaticResource SumLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Totals.Subtotal, Converter={StaticResource Money}}" Style="{StaticResource SumValue}"/>
                                    <TextBlock Grid.Row="1" Text="Discount" Style="{StaticResource SumLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Totals.DiscountTotal, Converter={StaticResource Money}, StringFormat='− {0}'}" Style="{StaticResource SumValue}"/>
                                    <TextBlock Grid.Row="2" Text="Delivery + installation" Style="{StaticResource SumLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SumValue}">
                                        <Run Text="{Binding Totals.DeliveryCharge, Converter={StaticResource Money}, Mode=OneWay}"/> + <Run Text="{Binding Totals.InstallationCharge, Converter={StaticResource Money}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Text="Taxable amount" Style="{StaticResource SumLabel}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Totals.TaxableTotal, Converter={StaticResource Money}}" Style="{StaticResource SumValue}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="4" Text="CGST" Style="{StaticResource SumLabel}" Visibility="{Binding IsInterState, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Totals.CgstTotal, Converter={StaticResource Money}}" Style="{StaticResource SumValue}"
                                               Visibility="{Binding IsInterState, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <TextBlock Grid.Row="5" Text="SGST" Style="{StaticResource SumLabel}" Visibility="{Binding IsInterState, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Totals.SgstTotal, Converter={StaticResource Money}}" Style="{StaticResource SumValue}"
                                               Visibility="{Binding IsInterState, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <TextBlock Grid.Row="6" Text="IGST (inter-state)" Style="{StaticResource SumLabel}" Visibility="{Binding IsInterState, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Totals.IgstTotal, Converter={StaticResource Money}}" Style="{StaticResource SumValue}"
                                               Visibility="{Binding IsInterState, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Row="7" Text="Round off" Style="{StaticResource SumLabel}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Totals.RoundOff, Converter={StaticResource Money}}" Style="{StaticResource SumValue}"/>
                                    <Border Grid.Row="8" Grid.ColumnSpan="2" Background="{StaticResource Primary}" CornerRadius="7" Padding="10,8" Margin="-4,6,-4,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotal, Converter={StaticResource Money}}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                            <TextBlock Text="GRAND TOTAL" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="{Binding TotalsError}" Style="{StaticResource FieldError}"/>
                                </Grid>
                            </Border>

                            <!-- payment (invoice only) -->
                            <StackPanel Visibility="{Binding ShowPayments, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="PAYMENT" Style="{StaticResource Label}"/>
                                <ItemsControl ItemsSource="{Binding PaymentMethods}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Code}" MinHeight="40" Margin="2" FontWeight="Bold" FontSize="12"
                                                    Command="{Binding DataContext.AddPaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding UseAdvance}" Visibility="{Binding AdvanceAvailable, Converter={StaticResource NullToVis}}">
                                    <TextBlock>
                                        <Run Text="Use customer advance"/> <Run Text="{Binding AdvanceAvailable, Converter={StaticResource Money}, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </CheckBox>
                                <Border Style="{StaticResource SoftPanel}" Margin="0,8,0,0" Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Credit sale — the full amount will be outstanding. A named customer is required." TextWrapping="Wrap" Foreground="{StaticResource WarningFg}"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding PaymentEntries}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PaymentEntry}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding MethodCode}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Amount, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                         AutomationProperties.Name="Amount"/>
                                                <TextBox Grid.Column="3" Text="{Binding Reference}" ToolTip="UPI ref / card last 4 / cheque no" IsEnabled="{Binding NeedsReference}"
                                                         AutomationProperties.Name="Reference"/>
                                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" FontSize="11"
                                                        Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Remove payment"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Advance applied" Style="{StaticResource SumLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AdvanceApplied, Converter={StaticResource Money}}" Style="{StaticResource SumValue}"/>
                                    <TextBlock Grid.Row="1" Text="Paid now" Style="{StaticResource SumLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PaidNow, Converter={StaticResource Money}}" Style="{StaticResource SumValue}" Foreground="{StaticResource SuccessFg}"/>
                                    <TextBlock Grid.Row="2" Text="Balance" Style="{StaticResource SumLabel}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Balance, Converter={StaticResource Money}}" Style="{StaticResource SumValue}" FontWeight="Bold" FontSize="15"
                                               Foreground="{Binding Balance, Converter={StaticResource BalanceBrush}}"/>
                                    <TextBlock Grid.Row="3" Text="Return change" Style="{StaticResource SumLabel}" Visibility="{Binding Change, Converter={StaticResource NullToVis}}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Change, Converter={StaticResource Money}}" Style="{StaticResource SumValue}" FontWeight="Bold"
                                               Foreground="{StaticResource WarningFg}" Visibility="{Binding Change, Converter={StaticResource NullToVis}}"/>
                                </Grid>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding Balance, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="Due date for balance" Style="{StaticResource Label}"/>
                                    <DatePicker SelectedDate="{Binding DueDate}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
