<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FurniShop.Wpf.ViewModels"
                    xmlns:c="clr-namespace:FurniShop.Wpf.Controls">

    <!-- =================================================================== Custom orders list -->
    <DataTemplate DataType="{x:Type vm:CustomOrderListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ New custom order" Command="{Binding NewCommand}" VerticalAlignment="Top"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}" RowHeight="50">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding Number}" Width="120" ElementStyle="{StaticResource BoldCell}"/>
                            <DataGridTemplateColumn Header="Customer" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerMobile}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Furniture" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ProductType}"/><TextBlock Style="{StaticResource Muted}"><Run Text="{Binding DimensionsText, Mode=OneWay}"/> · <Run Text="{Binding Material, Mode=OneWay}"/></TextBlock></StackPanel></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Promised" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExpectedCompletionDate, Converter={StaticResource Date}, ConverterParameter=dash}"/>
                                            <c:StatusBadge Status="OVERDUE" Text="Delayed" Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Price" Binding="{Binding FinalPrice, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Advance" Binding="{Binding AdvancePaid, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTemplateColumn Header="Stage" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Title="No custom orders here" Message="{Binding EmptyMessage}" Icon="&#xE90F;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Custom order editor -->
    <DataTemplate DataType="{x:Type vm:CustomOrderEditorViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="1200" HorizontalAlignment="Left">
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Save custom order" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" VerticalAlignment="Top" MinWidth="170"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FieldError}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Customer" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,8" Visibility="{Binding Customer, Converter={StaticResource NullToVis}}">
                                <TextBlock><Run Text="{Binding Customer.Name, Mode=OneWay}" FontWeight="Bold"/> · <Run Text="{Binding Customer.Mobile, Mode=OneWay}"/></TextBlock>
                            </Border>
                            <WrapPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="340" Margin="0,0,10,0" AutomationProperties.Name="Find customer"/>
                                <Button Content="+ New customer" Command="{Binding NewCustomerCommand}"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding CustomerResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="8,4"
                                                Command="{Binding DataContext.PickCustomerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding Mobile, Mode=OneWay}"/></TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=CustomerId}" Style="{StaticResource FieldError}"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Design &amp; measurements" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel>
                                    <StackPanel Width="230" Margin="0,0,12,10"><TextBlock Text="Product type *" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{Binding ProductTypes}" Text="{Binding Order.ProductType}" IsEditable="True"/>
                                        <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=ProductType}" Style="{StaticResource FieldError}"/></StackPanel>
                                    <StackPanel Width="330" Margin="0,0,12,10"><TextBlock Text="Design / style" Style="{StaticResource Label}"/><TextBox Text="{Binding Order.Design}"/></StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Width="90" Margin="0,0,10,10"><TextBlock Text="Width" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Order.Width, Converter={StaticResource Dec}}"/></StackPanel>
                                    <StackPanel Width="90" Margin="0,0,10,10"><TextBlock Text="Height" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Order.Height, Converter={StaticResource Dec}}"/></StackPanel>
                                    <StackPanel Width="90" Margin="0,0,10,10"><TextBlock Text="Depth" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Order.Depth, Converter={StaticResource Dec}}"/></StackPanel>
                                    <StackPanel Width="80" Margin="0,0,16,10"><TextBlock Text="Unit" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Order.DimensionUnit}"/></StackPanel>
                                    <StackPanel Width="80" Margin="0,0,10,10"><TextBlock Text="Doors" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Order.Doors, TargetNullValue=''}"/></StackPanel>
                                    <StackPanel Width="80" Margin="0,0,10,10"><TextBlock Text="Drawers" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Order.Drawers, TargetNullValue=''}"/></StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Width="170" Margin="0,0,10,10"><TextBlock Text="Material" Style="{StaticResource Label}"/><TextBox Text="{Binding Order.Material}"/></StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10"><TextBlock Text="Colour" Style="{StaticResource Label}"/><TextBox Text="{Binding Order.Color}"/></StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10"><TextBlock Text="Fabric" Style="{StaticResource Label}"/><TextBox Text="{Binding Order.Fabric}"/></StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,10"><TextBlock Text="Finish" Style="{StaticResource Label}"/><TextBox Text="{Binding Order.Finish}"/></StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Special requirements" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Order.SpecialRequirements}" Style="{StaticResource MultilineBox}"/>
                                <CheckBox Content="Installation required at site" IsChecked="{Binding Order.RequiresInstallation}" Margin="0,10,0,0"/>
                                <TextBlock Text="Delivery address" Style="{StaticResource Label}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Order.DeliveryAddress}" Style="{StaticResource MultilineBox}" MinHeight="48"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FlatCard}" Margin="0,0,0,12" Width="300" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Reference image / drawing" Style="{StaticResource Label}"/>
                                <Border Height="200" Background="{StaticResource SurfaceAlt}" CornerRadius="8">
                                    <Grid>
                                        <TextBlock Text="&#xE91B;" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource BorderStrong}" HorizontalAlignment="Center"
                                                   Visibility="{Binding ReferenceImage, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                        <Image Source="{Binding ReferenceImage}" Stretch="Uniform" Margin="6"/>
                                    </Grid>
                                </Border>
                                <Button Content="Attach photo / PDF" Command="{Binding UploadReferenceCommand}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Price, schedule and advance" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel>
                                <StackPanel Width="150" Margin="0,0,12,10"><TextBlock Text="Estimated cost *" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Order.EstimatedCost, Converter={StaticResource Dec}}"/>
                                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=EstimatedCost}" Style="{StaticResource FieldError}"/></StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,10"><TextBlock Text="Final price" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Order.FinalPrice, Converter={StaticResource Dec}}"/></StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,10" Visibility="{Binding CanSeeCost, Converter={StaticResource BoolToVis}}"><TextBlock Text="Production cost" Style="{StaticResource Label}"/>
                                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Order.ProductionCost, Converter={StaticResource Dec}}"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,12,10"><TextBlock Text="GST" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding GstRates}" SelectedItem="{Binding Order.GstRate}" ItemStringFormat="{}{0:0.##}%"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,12,10"><TextBlock Text="HSN" Style="{StaticResource Label}"/><TextBox Text="{Binding Order.HsnCode}"/></StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,10"><TextBlock Text="Price incl. GST" Style="{StaticResource Label}"/><CheckBox IsChecked="{Binding Order.PriceIncludesGst}" Content="Yes"/></StackPanel>
                                <StackPanel Width="160" Margin="0,0,12,10"><TextBlock Text="Promised completion" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Order.ExpectedCompletionDate}"/></StackPanel>
                            </WrapPanel>
                            <WrapPanel Visibility="{Binding CanTakeAdvance, Converter={StaticResource BoolToVis}}">
                                <StackPanel Width="150" Margin="0,0,12,10"><TextBlock Text="Advance received" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Advance, Converter={StaticResource Dec}}"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Paid by" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding AdvanceMethod}"/></StackPanel>
                                <StackPanel Width="180" Margin="0,0,12,10"><TextBlock Text="Reference" Style="{StaticResource Label}"/><TextBox Text="{Binding AdvanceReference}"/></StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Order.Notes}" Style="{StaticResource MultilineBox}" MinHeight="48"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Custom order detail -->
    <DataTemplate DataType="{x:Type vm:CustomOrderDetailViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <DockPanel Margin="0,0,0,10">
                        <c:StatusBadge DockPanel.Dock="Right" Status="{Binding Order.Status}" VerticalAlignment="Top"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
                    </DockPanel>
                    <ContentControl Content="{Binding Steps}" ContentTemplate="{StaticResource Stepper}" Margin="0,0,0,12" Focusable="False"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="{Binding NextLabel}" Command="{Binding MoveNextCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                Visibility="{Binding NextStatus, Converter={StaticResource NullToVis}}"/>
                        <Button Content="Collect advance / payment" Command="{Binding CollectAdvanceCommand}" Margin="0,0,8,8" Visibility="{Binding CanAdvance, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Generate invoice" Command="{Binding InvoiceCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,8" Visibility="{Binding CanInvoice, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Schedule delivery" Command="{Binding ScheduleDeliveryCommand}" Margin="0,0,8,8" Visibility="{Binding CanDeliver, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Open invoice" Command="{Binding OpenInvoiceCommand}" Margin="0,0,8,8" Visibility="{Binding Order.InvoiceId, Converter={StaticResource NullToVis}}"/>
                        <Button Content="WhatsApp update" Command="{Binding WhatsAppCommand}" Margin="0,0,8,8"/>
                        <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,8" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Cancel order" Command="{Binding CancelOrderCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <c:ResponsiveTiles MinTileWidth="260">
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="SPECIFICATION" Style="{StaticResource Label}"/>
                                        <TextBlock Style="{StaticResource Value}" FontWeight="SemiBold" Text="{Binding Order.ProductType}"/>
                                        <TextBlock Style="{StaticResource Value}" Text="{Binding Order.Design}"/>
                                        <TextBlock Style="{StaticResource Value}"><Run Text="Size:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Order.DimensionsText, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Value}"><Run Text="Material:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Order.Material, Mode=OneWay}"/> · <Run Text="{Binding Order.Finish, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Value}"><Run Text="Colour / fabric:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Order.Color, Mode=OneWay}"/> <Run Text="{Binding Order.Fabric, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Value}"><Run Text="Doors / drawers:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Order.Doors, Mode=OneWay}"/> / <Run Text="{Binding Order.Drawers, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding Order.SpecialRequirements}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="MONEY" Style="{StaticResource Label}"/>
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Order.EstimatedCost, Converter={StaticResource Money}}"/><TextBlock Text="Estimate" Foreground="{StaticResource TextSecondary}"/></DockPanel>
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Order.FinalPrice, Converter={StaticResource Money}}" FontWeight="SemiBold"/><TextBlock Text="Final price" Foreground="{StaticResource TextSecondary}"/></DockPanel>
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Order.AdvancePaid, Converter={StaticResource Money}}" Foreground="{StaticResource SuccessFg}"/><TextBlock Text="Advance / paid" Foreground="{StaticResource TextSecondary}"/></DockPanel>
                                        <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Order.Balance, Converter={StaticResource Money}}" FontSize="18" FontWeight="Bold" Foreground="{Binding Order.Balance, Converter={StaticResource BalanceBrush}}"/>
                                            <TextBlock Text="Balance" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                        <DockPanel Visibility="{Binding CanSeeCost, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Order.ProductionCost, Converter={StaticResource Money}, ConverterParameter=dash}"/><TextBlock Text="Production cost" Style="{StaticResource Muted}"/></DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOMER" Style="{StaticResource Label}"/>
                                        <Button Style="{StaticResource LinkButton}" Content="{Binding Order.CustomerName}" Command="{Binding OpenCustomerCommand}" FontSize="15"/>
                                        <TextBlock Text="{Binding Order.CustomerMobile}" Style="{StaticResource Value}"/>
                                        <TextBlock Text="{Binding Order.DeliveryAddress}" Style="{StaticResource Muted}"/>
                                        <TextBlock Style="{StaticResource Value}" Margin="0,6,0,0"><Run Text="Promised:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Order.ExpectedCompletionDate, Converter={StaticResource Date}, Mode=OneWay}"/></TextBlock>
                                        <c:StatusBadge Status="OVERDUE" Text="Past promised date" Visibility="{Binding Order.IsOverdue, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </c:ResponsiveTiles>
                            <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="Production history" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <c:StatusBadge DockPanel.Dock="Left" Status="{Binding ToStatus}" Margin="0,0,10,0"/>
                                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding ChangedAt, Converter={StaticResource Date}, ConverterParameter=time, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                                                        <Run Text="{Binding ChangedByName, Mode=OneWay}"/> <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/></TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12" Visibility="{Binding Payments.Count, Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Payments" Style="{StaticResource SectionTitle}"/>
                                    <DataGrid ItemsSource="{Binding Payments}" MaxHeight="240">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Receipt" Binding="{Binding Number}" Width="140"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, Converter={StaticResource Date}}" Width="110"/>
                                            <DataGridTextColumn Header="Mode" Binding="{Binding Methods}" Width="*"/>
                                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource FlatCard}" Width="300" VerticalAlignment="Top" Margin="0,0,12,12" Visibility="{Binding ReferenceImage, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="REFERENCE" Style="{StaticResource Label}"/>
                                <Image Source="{Binding ReferenceImage}" Stretch="Uniform" MaxHeight="360"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Deliveries -->
    <DataTemplate DataType="{x:Type vm:DeliveryListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,14" Focusable="False"/>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <c:AdaptiveList>
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}" RowHeight="52">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Delivery" Binding="{Binding Number}" Width="120" ElementStyle="{StaticResource BoldCell}"/>
                                <DataGridTemplateColumn Header="Customer / address" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock><Run Text="{Binding CustomerName, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding ContactMobile, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding DeliveryAddress}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Items" Binding="{Binding ItemsSummary}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                                <DataGridTextColumn Header="For" Binding="{Binding SourceNumber}" Width="120"/>
                                <DataGridTemplateColumn Header="Schedule" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ScheduledDate, Converter={StaticResource Date}, ConverterParameter=dash}"/><TextBlock Text="{Binding TimeSlot}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="120"/>
                                <DataGridTemplateColumn Header="Status" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}" BorderThickness="0" ItemContainerStyle="{StaticResource PlainListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                                        <StackPanel>
                                            <DockPanel><c:StatusBadge DockPanel.Dock="Right" Status="{Binding Status}"/><TextBlock><Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding CustomerName, Mode=OneWay}"/></TextBlock></DockPanel>
                                            <TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                                            <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding ScheduledDate, Converter={StaticResource Date}, Mode=OneWay}"/> <Run Text="{Binding TimeSlot, Mode=OneWay}"/> · <Run Text="{Binding DriverName, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </c:AdaptiveList>
                    <c:EmptyState Title="No deliveries here" Message="{Binding EmptyMessage}" Icon="&#xE804;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DeliveryDetailViewModel}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <DockPanel Margin="0,0,0,12">
                        <c:StatusBadge DockPanel.Dock="Right" Status="{Binding Delivery.Status}" VerticalAlignment="Top"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Out for delivery" Command="{Binding DispatchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Visibility="{Binding CanDispatch, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Mark delivered…" Command="{Binding CompleteCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,8" Visibility="{Binding CanComplete, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Failed" Command="{Binding FailCommand}" Margin="0,0,8,8" Visibility="{Binding CanComplete, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Call customer" Command="{Binding CallCommand}" Margin="0,0,8,8"/>
                        <Button Content="Open map" Command="{Binding MapCommand}" Margin="0,0,8,8"/>
                        <Button Content="Open order / invoice" Command="{Binding OpenSourceCommand}" Margin="0,0,8,8"/>
                        <Button Content="Cancel delivery" Command="{Binding CancelDeliveryCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <c:ResponsiveTiles MinTileWidth="320">
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="DELIVER TO" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding Delivery.CustomerName}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Delivery.ContactMobile}" Style="{StaticResource Value}"/>
                                <TextBlock Text="{Binding Delivery.DeliveryAddress}" Style="{StaticResource Value}" Margin="0,4,0,0"/>
                                <TextBlock Text="ITEMS" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding Delivery.Items}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource Value}"><Run Text="{Binding Quantity, Converter={StaticResource Qty}, Mode=OneWay}" FontWeight="Bold"/> × <Run Text="{Binding Description, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"><Run Text="For"/> <Run Text="{Binding Delivery.SourceNumber, Mode=OneWay}"/> · delivery charge billed <Run Text="{Binding Delivery.DeliveryCharge, Converter={StaticResource Money}, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12" Visibility="{Binding CanSchedule, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Schedule" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Date" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding ScheduleDate}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Time slot" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Slots}" Text="{Binding TimeSlot}" IsEditable="True"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Driver (staff)" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding Driver}" DisplayMemberPath="FullName"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="…or driver name" Style="{StaticResource Label}"/><TextBox Text="{Binding DriverName}"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Vehicle no" Style="{StaticResource Label}"/><TextBox Text="{Binding VehicleNo}" CharacterCasing="Upper"/></StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding CanSeeCost, Converter={StaticResource BoolToVis}}"><TextBlock Text="Trip cost (expense)" Style="{StaticResource Label}"/>
                                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding DeliveryCost, Converter={StaticResource Dec}}"/></StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Save schedule &amp; generate OTP" Style="{StaticResource PrimaryButton}" Command="{Binding ScheduleCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Send to customer" Command="{Binding SendScheduleCommand}" Style="{StaticResource SuccessButton}" Visibility="{Binding LastOtp, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource SoftPanel}" Margin="0,10,0,0" Visibility="{Binding LastOtp, Converter={StaticResource NullToVis}}">
                                    <TextBlock TextWrapping="Wrap"><Run Text="Delivery OTP for the customer:"/> <Run Text="{Binding LastOtp, Mode=OneWay}" FontWeight="Bold" FontSize="16"/>
                                        <LineBreak/><Run Text="Share it with the customer only (WhatsApp). The driver asks for it at handover; it is stored encrypted and cannot be shown again." Foreground="{StaticResource TextSecondary}"/></TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12" Visibility="{Binding IsDelivered, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Proof of delivery" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Value}"><Run Text="Received by:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Delivery.ReceiverName, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="At:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Delivery.DeliveredAt, Converter={StaticResource Date}, ConverterParameter=time, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}"><Run Text="OTP verified:" Foreground="{StaticResource TextMuted}"/> <Run Text="{Binding Delivery.OtpVerified, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding Delivery.Remarks}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Image Source="{Binding Signature}" Height="100" Margin="0,0,10,0" Visibility="{Binding Signature, Converter={StaticResource NullToVis}}"/>
                                    <Image Source="{Binding Photo}" Height="140" Visibility="{Binding Photo, Converter={StaticResource NullToVis}}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </c:ResponsiveTiles>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="History" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <c:StatusBadge DockPanel.Dock="Left" Status="{Binding ToStatus}" Margin="0,0,10,0"/>
                                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding ChangedAt, Converter={StaticResource Date}, ConverterParameter=time, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                                                <Run Text="{Binding ChangedByName, Mode=OneWay}"/> <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/></TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CompleteDeliveryDialogViewModel}">
        <StackPanel>
            <TextBlock Text="Received by *" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding ReceiverName}"/>
            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=ReceiverName}" Style="{StaticResource FieldError}"/>
            <TextBlock Text="Delivery OTP (from the customer)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
            <TextBox Text="{Binding Otp}" MaxLength="6" Width="140" HorizontalAlignment="Left" FontSize="16"/>
            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Otp}" Style="{StaticResource FieldError}"/>
            <TextBlock Text="Customer signature" Style="{StaticResource Label}" Margin="0,10,0,4"/>
            <c:SignaturePad/>
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Choose photo…" Command="{Binding PickPhotoCommand}"/>
                <TextBlock Text="{Binding PhotoPath, TargetNullValue='No photo attached'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Remarks" Style="{StaticResource Label}" Margin="0,10,0,4"/>
            <TextBox Text="{Binding Remarks}" Style="{StaticResource MultilineBox}" MinHeight="48"/>
            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Proof}" Style="{StaticResource FieldError}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Proof is required: OTP, signature, photo or remarks. The order moves to Delivered (and an installation job is created when needed)."/>
        </StackPanel>
    </DataTemplate>

    <!-- =================================================================== Installations -->
    <DataTemplate DataType="{x:Type vm:InstallationListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,14" Focusable="False"/>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}" RowHeight="50">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding Number}" Width="120" ElementStyle="{StaticResource BoldCell}"/>
                            <DataGridTemplateColumn Header="Customer / address" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock><Run Text="{Binding CustomerName, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding CustomerMobile, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryNumber}" Width="120"/>
                            <DataGridTextColumn Header="Technician" Binding="{Binding TechnicianName}" Width="150"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding ScheduledDate, Converter={StaticResource Date}, ConverterParameter=dash}" Width="110"/>
                            <DataGridTemplateColumn Header="Status" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><c:StatusBadge Status="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Manage" MinHeight="28" Padding="10,0" Command="{Binding DataContext.ManageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Title="No installation jobs" Message="Jobs are created automatically when furniture needing installation is delivered." Icon="&#xE90F;"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InstallationDialogViewModel}">
        <StackPanel>
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock><Run Text="{Binding Job.CustomerName, Mode=OneWay}" FontWeight="Bold"/> · <Run Text="{Binding Job.CustomerMobile, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Job.Address}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Date" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Date}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Technician" Style="{StaticResource Label}"/><TextBox Text="{Binding Technician}"/></StackPanel>
            </Grid>
            <StackPanel Margin="0,10,0,0" Visibility="{Binding CanSeeCost, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Installation cost (expense)" Style="{StaticResource Label}"/>
                <TextBox Style="{StaticResource NumberBox}" Text="{Binding Cost, Converter={StaticResource Dec}}" Width="160" HorizontalAlignment="Left"/>
            </StackPanel>
            <Border Style="{StaticResource FlatCard}" Margin="0,14,0,0" Visibility="{Binding CanComplete, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Job done?" Style="{StaticResource SectionTitle}"/>
                    <TextBox Text="{Binding CompletionNotes}" Style="{StaticResource MultilineBox}" MinHeight="48" ToolTip="Completion notes"/>
                    <Button Content="Mark installation completed" Style="{StaticResource SuccessButton}" Command="{Binding CompleteJobCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Button Content="Cancel this job" Style="{StaticResource LinkButton}" Foreground="{StaticResource ErrorFg}" Command="{Binding CancelJobCommand}" Margin="0,12,0,0"/>
        </StackPanel>
    </DataTemplate>

    <!-- =================================================================== Expenses -->
    <DataTemplate DataType="{x:Type vm:ExpenseListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ Add expense" Command="{Binding NewCommand}" VerticalAlignment="Top"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="130" ElementStyle="{StaticResource BoldCell}"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, Converter={StaticResource Date}}" Width="105"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Paid by" Binding="{Binding MethodCode, Converter={StaticResource StatusLabel}}" Width="90"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Added by" Binding="{Binding CreatedByName}" Width="130"/>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Foreground="{StaticResource ErrorFg}" ToolTip="Delete"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Title="No expenses" Message="{Binding EmptyMessage}" Icon="&#xE8C7;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ExpenseDialogViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Category *" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=CategoryId}" Style="{StaticResource FieldError}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Date" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Model.ExpenseDate}"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=ExpenseDate}" Style="{StaticResource FieldError}"/></StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Amount *" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Model.Amount, Converter={StaticResource Dec}}"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Amount}" Style="{StaticResource FieldError}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Paid by" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Model.MethodCode}"/></StackPanel>
            </Grid>
            <TextBlock Text="Description" Style="{StaticResource Label}" Margin="0,10,0,4"/>
            <TextBox Text="{Binding Model.Description}"/>
            <TextBlock Text="Reference (bill no, UTR)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
            <TextBox Text="{Binding Model.Reference}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
