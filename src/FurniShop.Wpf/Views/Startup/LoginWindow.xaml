<Window x:Class="FurniShop.Wpf.Views.Startup.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FurniShop — Sign in" Width="920" Height="600" MinWidth="420" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrandColumn" Width="*"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>
        <!-- Brand panel -->
        <Border x:Name="BrandPanel" Background="{StaticResource Sidebar}">
            <Grid Margin="44">
                <StackPanel VerticalAlignment="Top">
                    <Border Width="46" Height="46" CornerRadius="10" Background="{StaticResource Primary}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Foreground="White" FontSize="22" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ShopNameText" Text="FurniShop" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,22,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="Billing · Inventory · Orders · Delivery" Foreground="{StaticResource SidebarText}" FontSize="14"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Foreground="{StaticResource SidebarMuted}" FontSize="12" TextWrapping="Wrap"
                               Text="Every action is recorded in the activity log under your name. Do not share your password."/>
                    <TextBlock x:Name="DbText" Foreground="{StaticResource SidebarMuted}" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Form -->
        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" Margin="48,0" MaxWidth="360">
                <TextBlock Text="Sign in" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Use the username given by the shop owner." Style="{StaticResource PageSubtitle}" Margin="0,4,0,24"/>
                <TextBlock Text="Username" Style="{StaticResource Label}"/>
                <TextBox x:Name="UserBox" Margin="0,0,0,14" AutomationProperties.Name="Username"/>
                <TextBlock Text="Password" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" AutomationProperties.Name="Password"/>
                <TextBlock x:Name="ErrorText" Style="{StaticResource FieldError}" Margin="0,0,0,8"/>
                <Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource PrimaryButton}" MinHeight="42" IsDefault="True" Click="Login_Click" Margin="0,8,0,0"/>
                <Button Content="Change database connection" Style="{StaticResource LinkButton}" Margin="0,18,0,0" Click="ChangeDb_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
