<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FurniShop.Wpf.ViewModels"
                    xmlns:c="clr-namespace:FurniShop.Wpf.Controls">

    <!-- =================================================================== Reports -->
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
        <Grid Margin="24,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ContentControl Grid.ColumnSpan="2" Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,14" Focusable="False"/>
            <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="8" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Label}" Margin="8,6,0,4"/>
                                    <ListBox ItemsSource="{Binding}" SelectedItem="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                             BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PlainListItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Title}" Padding="8,6" ToolTip="{Binding Description}"/></DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Print" Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                        <Menu Background="Transparent" VerticalAlignment="Center" Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}">
                            <MenuItem Header="Export ▾" FontWeight="SemiBold" Padding="10,8">
                                <MenuItem Header="Excel (.xlsx)" Command="{Binding ExportCommand}" CommandParameter="excel"/>
                                <MenuItem Header="CSV" Command="{Binding ExportCommand}" CommandParameter="csv"/>
                                <MenuItem Header="PDF" Command="{Binding ExportCommand}" CommandParameter="pdf"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Title}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Selected.Description, Mode=OneWay}"/> · <Run Text="{Binding Result.Subtitle, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="12" Margin="0,0,0,10">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6" Visibility="{Binding Selected.UsesDates, Converter={StaticResource BoolToVis}}">
                            <DatePicker SelectedDate="{Binding From}" Width="135" ToolTip="From"/>
                            <TextBlock Text="to" Margin="6,0" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding To}" Width="135" ToolTip="To"/>
                            <ComboBox ItemsSource="{Binding Presets}" Width="170" Margin="8,0,0,0" ToolTip="Quick range" x:Name="Preset"
                                      SelectedValuePath="Value"/>
                            <Button Content="Apply" Margin="6,0,0,0" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding SelectedValue, ElementName=Preset}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Groupings}" SelectedItem="{Binding Grouping}" Width="120" Margin="0,0,12,6"
                                  Visibility="{Binding Selected.UsesGrouping, Converter={StaticResource BoolToVis}}" ToolTip="Group by"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" Width="170" Margin="0,0,12,6"
                                  Visibility="{Binding Selected.UsesCategory, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" DisplayMemberPath="ProductName" Width="200" Margin="0,0,12,6" IsTextSearchEnabled="True"
                                  Visibility="{Binding Selected.UsesProduct, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" Width="200" Margin="0,0,12,6" IsTextSearchEnabled="True"
                                  Visibility="{Binding Selected.UsesCustomer, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" Width="200" Margin="0,0,12,6"
                                  Visibility="{Binding Selected.UsesSupplier, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Run report" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" Margin="0,0,0,6"/>
                    </WrapPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="True" CanUserSortColumns="True" AutomationProperties.Name="Report results"/>
                        <c:EmptyState Title="No data" Message="Nothing matches these filters." Icon="&#xE9D2;"
                                      Visibility="{Binding View.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                    </Grid>
                </Border>
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Result.Totals}" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SoftPanel}" Margin="8,0,0,6" Padding="10,6">
                                <TextBlock><Run Text="{Binding Item1, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>: <Run Text="{Binding Item2, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Users -->
    <DataTemplate DataType="{x:Type vm:UserListViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ New user" Command="{Binding NewCommand}" VerticalAlignment="Top"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Focusable="False"/>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Users}" c:GridBehaviors.OpenCommand="{Binding EditCommand}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Username}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="150"/>
                            <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="120"/>
                            <DataGridTextColumn Header="Last sign-in" Binding="{Binding LastLoginAt, Converter={StaticResource Date}, ConverterParameter=time}" Width="150"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <c:StatusBadge Status="ACTIVE" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            <c:StatusBadge Status="CANCELLED" Text="Disabled" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Locked until" Binding="{Binding LockedUntil, Converter={StaticResource Date}, ConverterParameter=time}" Width="140"/>
                            <DataGridTemplateColumn Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" MinHeight="28" Padding="10,0" Margin="0,0,6,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="Unlock" MinHeight="28" Padding="10,0" Margin="0,0,6,0" Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding LockedUntil, Converter={StaticResource NullToVis}}"/>
                                            <Button Content="Delete" MinHeight="28" Padding="10,0" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UserDialogViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Full name *" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.FullName}"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=FullName}" Style="{StaticResource FieldError}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Username *" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.Username}" IsEnabled="{Binding IsNew}"/>
                    <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Username}" Style="{StaticResource FieldError}"/></StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Mobile" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.Mobile}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Email" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.Email}"/></StackPanel>
            </Grid>
            <TextBlock Text="Role" Style="{StaticResource Label}" Margin="0,10,0,4"/>
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" DisplayMemberPath="Name"/>
            <TextBlock Text="{Binding Role.Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <TextBlock Text="Password" Style="{StaticResource Label}" Margin="0,10,0,4"/>
            <PasswordBox c:PasswordHelper.BoundPassword="{Binding Password}"/>
            <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Password}" Style="{StaticResource FieldError}"/>
            <CheckBox Content="Account active" IsChecked="{Binding Model.IsActive}" Margin="0,10,0,0"/>
        </StackPanel>
    </DataTemplate>

    <!-- =================================================================== Roles & permissions -->
    <DataTemplate DataType="{x:Type vm:RolesViewModel}">
        <Grid Margin="24,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ContentControl Grid.ColumnSpan="2" Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,14" Focusable="False"/>
            <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="8" Margin="0,0,12,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="+ New role" Command="{Binding NewRoleCommand}" Margin="4"/>
                    <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" BorderThickness="0" ItemContainerStyle="{StaticResource PlainListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding UserCount, Mode=OneWay}"/> user(s)</TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Role name" Style="{StaticResource Label}"/><TextBox Text="{Binding RoleName}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Description" Style="{StaticResource Label}"/><TextBox Text="{Binding RoleDescription}"/></StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                                <Button Content="Save role" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,8" Text="Tick what this role may do. 'See cost price' also controls profit reports and margins."/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Grouped}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Margin="0,0,12,12" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><CheckBox IsChecked="{Binding Granted}" Content="{Binding Info.Description}" ToolTip="{Binding Info.Code}"/></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Activity log -->
    <DataTemplate DataType="{x:Type vm:ActivityLogViewModel}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,14" Focusable="False"/>
            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ListToolbar}" Focusable="False"/>
            <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" c:GridBehaviors.OpenCommand="{Binding OpenCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding OccurredAt, Converter={StaticResource Date}, ConverterParameter=time}" Width="145"/>
                            <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="110"/>
                            <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="110"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action, Converter={StaticResource StatusLabel}}" Width="110"/>
                            <DataGridTextColumn Header="What happened" Binding="{Binding Summary}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Record" Binding="{Binding RecordRef}" Width="130"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding Machine}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:EmptyState Title="No activity" Message="{Binding EmptyMessage}" Icon="&#xE81C;" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" ContentTemplate="{StaticResource ListPager}" Focusable="False"/>
        </Grid>
    </DataTemplate>

    <!-- =================================================================== Settings -->
    <Style x:Key="FieldBlock" TargetType="StackPanel">
        <Setter Property="Width" Value="260"/>
        <Setter Property="Margin" Value="0,0,14,12"/>
    </Style>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <Grid>
            <DockPanel Margin="24,20">
                <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource PageHeading}" Margin="0,0,0,8" Focusable="False"/>
                <TabControl SelectedIndex="{Binding SelectedTab}">
                    <!-- SHOP -->
                    <TabItem Header="Shop">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource FlatCard}">
                                <StackPanel>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="360"><TextBlock Text="Shop name *" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.ShopName}"/>
                                            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=ShopName}" Style="{StaticResource FieldError}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="360"><TextBlock Text="Tagline" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.Tagline}"/></StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="Address" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Shop.Address}" Style="{StaticResource MultilineBox}" MinHeight="50" Margin="0,0,0,12" MaxWidth="740" HorizontalAlignment="Left" Width="740"/>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="200"><TextBlock Text="City" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.City}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="State (for CGST/SGST vs IGST) *" Style="{StaticResource Label}"/>
                                            <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding ShopState}" DisplayMemberPath="Display"/>
                                            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=StateCode}" Style="{StaticResource FieldError}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="120"><TextBlock Text="PIN code" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.Pincode}" MaxLength="6"/>
                                            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Pincode}" Style="{StaticResource FieldError}"/></StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="Phone" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.Phone}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="Email" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.Email}"/>
                                            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Email}" Style="{StaticResource FieldError}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="Website" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.Website}"/></StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="GSTIN" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.Gstin}" CharacterCasing="Upper" MaxLength="15"/>
                                            <TextBlock Text="{Binding Errors, Converter={StaticResource Err}, ConverterParameter=Gstin}" Style="{StaticResource FieldError}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="PAN" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.Pan}" CharacterCasing="Upper" MaxLength="10"/></StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="Bank / UPI details printed on invoices" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="Bank name &amp; branch" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.BankName}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="Account number" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.BankAccount}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="160"><TextBlock Text="IFSC" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.BankIfsc}" CharacterCasing="Upper"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="UPI ID" Style="{StaticResource Label}"/><TextBox Text="{Binding Shop.UpiId}"/></StackPanel>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Upload logo" Command="{Binding UploadLogoCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Save shop details" Style="{StaticResource PrimaryButton}" Command="{Binding SaveShopCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- GST & TAX -->
                    <TabItem Header="GST &amp; Tax">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Defaults" Style="{StaticResource SectionTitle}"/>
                                        <CheckBox Content="Business is GST registered (untick to issue bills of supply with 0% GST)" IsChecked="{Binding Tax.GstRegistered}"/>
                                        <CheckBox Content="Product prices include GST by default" IsChecked="{Binding Tax.DefaultPriceIncludesGst}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="180"><TextBlock Text="Default GST rate %" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Tax.DefaultGstRate, Converter={StaticResource Dec}}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="240"><TextBlock Text="GST on delivery / installation %" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Tax.ChargesGstRate, Converter={StaticResource Dec}}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="180"><TextBlock Text="Default HSN" Style="{StaticResource Label}"/><TextBox Text="{Binding Tax.DefaultHsn}"/></StackPanel>
                                        </WrapPanel>
                                        <Button Content="Save tax settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTaxCommand}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <c:ResponsiveTiles MinTileWidth="460">
                                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="GST rates" Style="{StaticResource SectionTitle}"/>
                                            <DataGrid ItemsSource="{Binding GstRates}" IsReadOnly="False" MaxHeight="300" SelectionUnit="Cell">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Rate %" Binding="{Binding Rate}" Width="80" IsReadOnly="True"/>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                    <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                    <DataGridTemplateColumn Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                        <Button Content="Save" MinHeight="26" Padding="8,0" Command="{Binding DataContext.SaveRateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <WrapPanel Margin="0,10,0,0">
                                                <TextBox Width="160" Text="{Binding NewRate.Name}" Margin="0,0,8,0" ToolTip="Name"/>
                                                <TextBox Width="80" Style="{StaticResource NumberBox}" Text="{Binding NewRate.Rate, Converter={StaticResource Dec}}" Margin="0,0,8,0" ToolTip="Rate %"/>
                                                <Button Content="Add rate" Command="{Binding SaveRateCommand}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="HSN / SAC codes" Style="{StaticResource SectionTitle}"/>
                                            <DataGrid ItemsSource="{Binding HsnCodes}" IsReadOnly="False" MaxHeight="300" SelectionUnit="Cell">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                                    <DataGridTextColumn Header="GST %" Binding="{Binding DefaultGstRate}" Width="60"/>
                                                    <DataGridTemplateColumn Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                        <Button Content="Save" MinHeight="26" Padding="8,0" Command="{Binding DataContext.SaveHsnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <WrapPanel Margin="0,10,0,0">
                                                <TextBox Width="90" Text="{Binding NewHsn.Code}" Margin="0,0,8,0" ToolTip="Code"/>
                                                <TextBox Width="200" Text="{Binding NewHsn.Description}" Margin="0,0,8,0" ToolTip="Description"/>
                                                <TextBox Width="60" Style="{StaticResource NumberBox}" Text="{Binding NewHsn.DefaultGstRate, Converter={StaticResource Dec}}" Margin="0,0,8,0" ToolTip="GST %"/>
                                                <Button Content="Add HSN" Command="{Binding SaveHsnCommand}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </c:ResponsiveTiles>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- INVOICE -->
                    <TabItem Header="Invoice &amp; numbering">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Invoice layout" Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}"><TextBlock Text="Title" Style="{StaticResource Label}"/><TextBox Text="{Binding Invoice.Title}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="160"><TextBlock Text="Default print format" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding PrintFormats}" SelectedItem="{Binding Invoice.DefaultPrintFormat}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="160"><TextBlock Text="Credit days" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Invoice.DefaultDueDays}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="190"><TextBlock Text="Quotation validity (days)" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Invoice.QuotationValidityDays}"/></StackPanel>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <CheckBox Content="Round off to nearest rupee" IsChecked="{Binding Invoice.RoundOff}" Margin="0,0,18,0"/>
                                            <CheckBox Content="Amount in words" IsChecked="{Binding Invoice.ShowAmountInWords}" Margin="0,0,18,0"/>
                                            <CheckBox Content="Bank / UPI details" IsChecked="{Binding Invoice.ShowBankDetails}" Margin="0,0,18,0"/>
                                            <CheckBox Content="Signature box" IsChecked="{Binding Invoice.ShowSignatureBox}"/>
                                        </WrapPanel>
                                        <TextBlock Text="Terms &amp; conditions" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                        <TextBox Text="{Binding Invoice.Terms}" Style="{StaticResource MultilineBox}" MinHeight="100"/>
                                        <TextBlock Text="Footer message" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                        <TextBox Text="{Binding Invoice.Footer}"/>
                                        <Button Content="Save invoice settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveInvoiceCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FlatCard}">
                                    <StackPanel>
                                        <TextBlock Text="Document numbering" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Text="Example INV-2026-0001. Numbers are assigned inside the database transaction, so they are unique and gap-free. Year-based series restart at 1 each calendar year. The invoice number cannot be moved backwards."/>
                                        <DataGrid ItemsSource="{Binding Sequences}" IsReadOnly="False" SelectionUnit="Cell" MaxHeight="440">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Document" Binding="{Binding DocType, Converter={StaticResource StatusLabel}}" Width="*" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="90"/>
                                                <DataGridCheckBoxColumn Header="Year" Binding="{Binding IncludeYear, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Digits" Binding="{Binding Padding}" Width="60"/>
                                                <DataGridTextColumn Header="Next number" Binding="{Binding NextNumber}" Width="110"/>
                                                <DataGridTemplateColumn Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <Button Content="Save" MinHeight="26" Padding="8,0" Command="{Binding DataContext.SaveSequenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PAYMENTS, DELIVERY, EXPENSES -->
                    <TabItem Header="Payments &amp; delivery">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <c:ResponsiveTiles MinTileWidth="480">
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="Payment methods" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid ItemsSource="{Binding PaymentMethods}" IsReadOnly="False" SelectionUnit="Cell" MaxHeight="320">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                <DataGridTextColumn Header="Order" Binding="{Binding SortOrder}" Width="60"/>
                                                <DataGridTemplateColumn Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <Button Content="Save" MinHeight="26" Padding="8,0" Command="{Binding DataContext.SaveMethodCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBox Width="100" Text="{Binding NewMethod.Code}" CharacterCasing="Upper" Margin="0,0,8,0" ToolTip="Code, e.g. PAYTM"/>
                                            <TextBox Width="170" Text="{Binding NewMethod.Name}" Margin="0,0,8,0" ToolTip="Name"/>
                                            <Button Content="Add method" Command="{Binding SaveMethodCommand}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="Delivery, installation &amp; stock" Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="200"><TextBlock Text="Default delivery charge" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Delivery.DefaultDeliveryCharge, Converter={StaticResource Dec}}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="200"><TextBlock Text="Default installation charge" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Delivery.DefaultInstallationCharge, Converter={StaticResource Dec}}"/></StackPanel>
                                        </WrapPanel>
                                        <CheckBox Content="Require the customer OTP to complete a delivery" IsChecked="{Binding Delivery.RequireOtp}"/>
                                        <CheckBox Content="Create a pending delivery automatically for invoices marked 'home delivery'" IsChecked="{Binding Delivery.AutoCreateDelivery}"/>
                                        <CheckBox Content="Reserve stock when a sales order is confirmed" IsChecked="{Binding Inventory.ReserveOnSalesOrderConfirm}"/>
                                        <CheckBox Content="Update product cost price from each completed purchase" IsChecked="{Binding Inventory.UpdateCostOnPurchase}"/>
                                        <CheckBox Content="Allow negative stock (admin only — not recommended)" IsChecked="{Binding Inventory.AllowNegativeStock}" IsEnabled="{Binding IsAdmin}"
                                                  Foreground="{StaticResource ErrorFg}"/>
                                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveDeliveryCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="Expense categories" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid ItemsSource="{Binding ExpenseCategories}" IsReadOnly="False" SelectionUnit="Cell" MaxHeight="300">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                <DataGridTemplateColumn Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <Button Content="Save" MinHeight="26" Padding="8,0" Command="{Binding DataContext.SaveExpenseCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBox Width="200" Text="{Binding NewExpenseCategory.Name}" Margin="0,0,8,0"/>
                                            <Button Content="Add category" Command="{Binding SaveExpenseCategoryCommand}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </c:ResponsiveTiles>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PRINTERS -->
                    <TabItem Header="Printers">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource FlatCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" Text="Leave a printer empty to choose it each time. Thermal receipts are laid out for 80 mm or 58 mm rolls."/>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="320"><TextBlock Text="A4 printer (invoices, quotations, receipts)" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Printer.A4PrinterName}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="320"><TextBlock Text="Thermal receipt printer" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Printer.ThermalPrinterName}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="140"><TextBlock Text="Roll width (mm)" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ThermalWidths}" SelectedItem="{Binding Printer.ThermalWidthMm}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="320"><TextBlock Text="Label printer (50 × 25 mm)" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Printer.LabelPrinterName}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="100"><TextBlock Text="Copies" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Printer.Copies}"/></StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="Folder for saved PDFs" Style="{StaticResource Label}"/>
                                    <DockPanel MaxWidth="640" HorizontalAlignment="Left" Width="640">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowsePdfFolderCommand}" Margin="8,0,0,0"/>
                                        <TextBox Text="{Binding Printer.PdfFolder}" ToolTip="Default: Documents\FurniShop"/>
                                    </DockPanel>
                                    <Button Content="Save printer settings" Style="{StaticResource PrimaryButton}" Command="{Binding SavePrinterCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- WHATSAPP -->
                    <TabItem Header="WhatsApp">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource FlatCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Text="Messages open in WhatsApp (desktop app or web) with the text filled in; staff press Send. PDFs are saved and their folder opened so they can be attached. Placeholders: {customer} {shop} {shop_phone} {number} {total} {paid} {balance} {amount} {method} {date} {due_date} {valid_until} {slot} {driver} {vehicle} {otp}"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="120"><TextBlock Text="Country code" Style="{StaticResource Label}"/><TextBox Text="{Binding WhatsApp.CountryCode}"/></StackPanel>
                                        <CheckBox Content="Open the WhatsApp desktop app instead of the browser" IsChecked="{Binding WhatsApp.UseDesktopApp}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Preview" Command="{Binding PreviewTemplateCommand}" CommandParameter="{Binding WhatsApp.InvoiceTemplate}"/><TextBlock Text="Invoice" Style="{StaticResource Label}"/></DockPanel>
                                            <TextBox Text="{Binding WhatsApp.InvoiceTemplate}" Style="{StaticResource MultilineBox}" Margin="0,0,0,10"/>
                                            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Preview" Command="{Binding PreviewTemplateCommand}" CommandParameter="{Binding WhatsApp.QuotationTemplate}"/><TextBlock Text="Quotation" Style="{StaticResource Label}"/></DockPanel>
                                            <TextBox Text="{Binding WhatsApp.QuotationTemplate}" Style="{StaticResource MultilineBox}" Margin="0,0,0,10"/>
                                            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Preview" Command="{Binding PreviewTemplateCommand}" CommandParameter="{Binding WhatsApp.ReceiptTemplate}"/><TextBlock Text="Payment receipt" Style="{StaticResource Label}"/></DockPanel>
                                            <TextBox Text="{Binding WhatsApp.ReceiptTemplate}" Style="{StaticResource MultilineBox}" Margin="0,0,0,10"/>
                                            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Preview" Command="{Binding PreviewTemplateCommand}" CommandParameter="{Binding WhatsApp.ReminderTemplate}"/><TextBlock Text="Outstanding reminder" Style="{StaticResource Label}"/></DockPanel>
                                            <TextBox Text="{Binding WhatsApp.ReminderTemplate}" Style="{StaticResource MultilineBox}" Margin="0,0,0,10"/>
                                            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Preview" Command="{Binding PreviewTemplateCommand}" CommandParameter="{Binding WhatsApp.DeliveryTemplate}"/><TextBlock Text="Delivery information" Style="{StaticResource Label}"/></DockPanel>
                                            <TextBox Text="{Binding WhatsApp.DeliveryTemplate}" Style="{StaticResource MultilineBox}" Margin="0,0,0,10"/>
                                            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Preview" Command="{Binding PreviewTemplateCommand}" CommandParameter="{Binding WhatsApp.OrderConfirmationTemplate}"/><TextBlock Text="Order confirmation" Style="{StaticResource Label}"/></DockPanel>
                                            <TextBox Text="{Binding WhatsApp.OrderConfirmationTemplate}" Style="{StaticResource MultilineBox}" Margin="0,0,0,10"/>
                                            <Button Content="Save templates" Style="{StaticResource PrimaryButton}" Command="{Binding SaveWhatsAppCommand}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#E7F6E7" CornerRadius="10" Padding="14" VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="PREVIEW" Style="{StaticResource Label}"/>
                                                <Border Background="White" CornerRadius="8" Padding="10">
                                                    <TextBlock Text="{Binding TemplatePreview, TargetNullValue='Click Preview next to a template'}" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SECURITY -->
                    <TabItem Header="Security">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource FlatCard}">
                                <StackPanel>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="220"><TextBlock Text="Lock account after failed sign-ins" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Security.MaxFailedLogins}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="200"><TextBlock Text="Lock duration (minutes)" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Security.LockoutMinutes}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="220"><TextBlock Text="Auto sign-out after idle (min, 0 = never)" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Security.IdleTimeoutMinutes}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="200"><TextBlock Text="Minimum password length" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Security.MinPasswordLength}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FieldBlock}" Width="220"><TextBlock Text="Password expiry (days, 0 = never)" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Security.PasswordExpiryDays}"/></StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FieldError}"/>
                                    <Button Content="Save security settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSecurityCommand}" HorizontalAlignment="Left" Margin="0,4,0,14"/>
                                    <Border Style="{StaticResource SoftPanel}">
                                        <TextBlock TextWrapping="Wrap" Text="Passwords are stored as salted PBKDF2-SHA256 hashes. Every service checks the user's permissions before reading or changing data; the database itself blocks editing or deleting payments, stock movements, finalised invoices and the activity log. The database connection string is stored encrypted for this Windows user (DPAPI)."/>
                                    </Border>
                                    <Button Content="Connect this PC to a different database…" Command="{Binding ChangeConnectionCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- BACKUP -->
                    <TabItem Header="Backup">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BackupStatus}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <c:ResponsiveTiles MinTileWidth="300">
                                            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="1. Neon point-in-time restore" FontWeight="SemiBold"/>
                                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                               Text="Neon keeps a history of your database. In the Neon console you can restore or branch the database to any moment within your plan's history window — the safety net for mistakes."/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="2. Full database backup (pg_dump)" FontWeight="SemiBold"/>
                                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,4,8,8"
                                                               Text="A complete copy you keep yourself. Needs the free PostgreSQL command-line tools on this PC. Restore replaces all data."/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Back up now" Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}" Margin="0,0,8,0"/>
                                                        <Button Content="Restore…" Style="{StaticResource DangerButton}" Command="{Binding RestoreCommand}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SoftPanel}" Margin="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="3. Export all data (ZIP of JSON)" FontWeight="SemiBold"/>
                                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,4,8,8"
                                                               Text="Readable copy of every table for your accountant or for migration. No extra software needed. Passwords are never exported."/>
                                                    <Button Content="Export data" Command="{Binding ExportDataCommand}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                        </c:ResponsiveTiles>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FlatCard}">
                                    <StackPanel>
                                        <TextBlock Text="Backup settings" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Backup folder" Style="{StaticResource Label}"/>
                                        <DockPanel Width="640" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBackupFolderCommand}" Margin="8,0,0,0"/>
                                            <TextBox Text="{Binding Backup.BackupFolder}" ToolTip="Default: Documents\FurniShop\Backups — ideally a folder synced to cloud storage"/>
                                        </DockPanel>
                                        <WrapPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="320"><TextBlock Text="pg_dump.exe path (optional)" Style="{StaticResource Label}"/><TextBox Text="{Binding Backup.PgDumpPath}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="320"><TextBlock Text="pg_restore.exe path (optional)" Style="{StaticResource Label}"/><TextBox Text="{Binding Backup.PgRestorePath}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FieldBlock}" Width="200"><TextBlock Text="Remind after (days)" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumberBox}" Text="{Binding Backup.ReminderDays}"/></StackPanel>
                                        </WrapPanel>
                                        <Button Content="Save backup settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveBackupSettingsCommand}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Busy}" Focusable="False"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
