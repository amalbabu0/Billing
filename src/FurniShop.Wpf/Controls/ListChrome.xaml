<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:FurniShop.Wpf.Controls">

    <!-- Filter bar bound to ListPageViewModel<T>: search, status, dates, clear, export -->
    <DataTemplate x:Key="ListToolbar">
        <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
            <Grid Width="300" Margin="0,0,10,8">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="32,0,8,0" AutomationProperties.Name="{Binding SearchHint}"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="11,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding SearchHint}" Foreground="{StaticResource TextMuted}" Margin="33,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding Search, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
            </Grid>
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="170" Margin="0,0,10,8"
                      Visibility="{Binding ShowStatusFilter, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Status filter"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,8" Visibility="{Binding ShowDateFilter, Converter={StaticResource BoolToVis}}">
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" AutomationProperties.Name="From date"/>
                <TextBlock Text="to" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" AutomationProperties.Name="To date"/>
            </StackPanel>
            <Button Style="{StaticResource GhostButton}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="0,0,10,8"/>
            <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,8" ToolTip="Refresh">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Refresh"/></StackPanel>
            </Button>
            <Menu Background="Transparent" Margin="0,0,0,8" VerticalAlignment="Center" Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="Export ▾" FontWeight="SemiBold" Padding="10,8">
                    <MenuItem Header="Excel (.xlsx)" Command="{Binding ExportCommand}" CommandParameter="excel"/>
                    <MenuItem Header="CSV" Command="{Binding ExportCommand}" CommandParameter="csv"/>
                    <MenuItem Header="PDF" Command="{Binding ExportCommand}" CommandParameter="pdf"/>
                </MenuItem>
            </Menu>
        </WrapPanel>
    </DataTemplate>

    <!-- Pager -->
    <DataTemplate x:Key="ListPager">
        <DockPanel Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PrevPageCommand}" ToolTip="Previous page" AutomationProperties.Name="Previous page"/>
                <TextBlock VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextSecondary}">
                    <Run Text="Page"/> <Run Text="{Binding Page, Mode=OneWay}"/> <Run Text="of"/> <Run Text="{Binding PageCount, Mode=OneWay}"/>
                </TextBlock>
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextPageCommand}" ToolTip="Next page" AutomationProperties.Name="Next page"/>
            </StackPanel>
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
        </DockPanel>
    </DataTemplate>

    <!-- Busy overlay for cards -->
    <DataTemplate x:Key="Busy">
        <Border Background="#A0FFFFFF" CornerRadius="10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="160" Height="4"/>
                <TextBlock Text="Loading…" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Page header: title / subtitle (buttons are added by each page) -->
    <DataTemplate x:Key="PageHeading">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
