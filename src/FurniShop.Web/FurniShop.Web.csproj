<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FurniShop.Web</RootNamespace>
    <AssemblyName>FurniShop.Web</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>furnishop-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FurniShop.Infrastructure\FurniShop.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The React client builds into wwwroot (npm run build in /web). -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
